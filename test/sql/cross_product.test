# name: test/sql/cross_product.test
# description: test lpts with CROSS PRODUCT / CROSS JOIN queries
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE users (id INTEGER, name VARCHAR);

statement ok
CREATE TABLE orders (id INTEGER, user_id INTEGER, amount DECIMAL);

statement ok
CREATE TABLE staff (id INTEGER, dept VARCHAR, salary INTEGER);

statement ok
INSERT INTO users VALUES (1, 'Alice'), (2, 'Bob');

statement ok
INSERT INTO orders VALUES (1, 1, 100), (2, 2, 200);

statement ok
INSERT INTO staff VALUES (1, 'eng', 50000), (2, 'sales', 60000);

# Explicit CROSS JOIN
statement ok
SELECT u.name, o.amount FROM users u CROSS JOIN orders o;

# Implicit cross product (comma notation)
statement ok
SELECT u.name, s.salary FROM users u, staff s;

# 3-way cross product
statement ok
SELECT u.name, o.amount, s.salary FROM users u, orders o, staff s;

# Cross product with filter (optimizer may convert to COMPARISON_JOIN or keep as CROSS + FILTER)
statement ok
SELECT u.name, o.amount FROM users u, orders o WHERE u.id = o.user_id;

# Cross product with aggregate
statement ok
SELECT u.name, SUM(o.amount) FROM users u CROSS JOIN orders o GROUP BY u.name;

# Cross product preserves all columns from both sides
statement ok
SELECT u.id, u.name, o.id, o.user_id, o.amount FROM users u CROSS JOIN orders o;

# Cross product with duplicate column names (both tables have "id")
statement ok
SELECT u.id, o.id FROM users u CROSS JOIN orders o;

# A projected UNNEST child can expose rewritten bindings on the CROSS_PRODUCT itself.
# The cross product must use the columns actually emitted by its children.
statement ok
SELECT t.t AS tier, COUNT(*)
FROM (SELECT unnest(['premium', 'standard', 'basic']) AS t) t
CROSS JOIN users u
GROUP BY t.t;
