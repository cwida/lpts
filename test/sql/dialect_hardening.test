# name: test/sql/dialect_hardening.test
# description: fail-closed dialect diagnostics for unsupported functions, types, date tokens, and operators
# group: [sql]

require lpts

# Feldera is PostgreSQL-like but supports ARG_MIN/ARG_MAX directly. Its
# DataFusion-backed ad-hoc evaluator also needs standard EXTRACT syntax.
statement ok
CREATE TABLE feldera_edges (id INTEGER, amount DECIMAL(12,2), ts TIMESTAMP, name VARCHAR);

statement ok
SET lpts_dialect = 'feldera';

query III
SELECT sql LIKE '%arg_min(%' AS arg_min_preserved,
       sql LIKE '%arg_max(%' AS arg_max_preserved,
       sql NOT LIKE '%LPTS_UNSUPPORTED_FUNCTION%' AS translated
FROM lpts_query('SELECT arg_min(id, amount), arg_max(id, amount) FROM feldera_edges');
----
true	true	true

query II
SELECT sql LIKE '%EXTRACT(YEAR FROM%' AS extract_year,
       sql LIKE '%EXTRACT(MONTH FROM%' AS extract_month
FROM lpts_query('SELECT extract(year FROM ts), extract(month FROM ts) FROM feldera_edges');
----
true	true

query II
SELECT sql LIKE '%INTERVAL ''30'' DAY%' AS ansi_interval,
       sql NOT LIKE '%::INTERVAL%' AS no_duckdb_interval_cast
FROM lpts_query('SELECT ts + INTERVAL ''30'' DAY FROM feldera_edges');
----
true	true

query II
SELECT sql LIKE '%FORMAT_TIMESTAMP(''%Y-%m'', ts)%' AS format_timestamp,
       sql LIKE '%PARSE_TIMESTAMP(''%Y-%m-%d'', t0_name)%' AS parse_timestamp
FROM lpts_query('SELECT strftime(ts, ''%Y-%m''), strptime(name, ''%Y-%m-%d'') FROM feldera_edges');
----
true	true

statement ok
SET lpts_dialect = 'duckdb';

statement ok
CREATE TABLE users (id INTEGER, name VARCHAR, ts TIMESTAMP, vals INTEGER[]);

statement ok
INSERT INTO users VALUES (1, 'Alice', TIMESTAMP '2024-01-15 12:34:56', [1, 2, 3]);

# Unsupported list functions should fail before emitting plausible target SQL.
statement ok
SET lpts_dialect = 'postgres';

statement error
SELECT sql FROM lpts_query('SELECT list_contains(vals, 2) FROM users');
----
LPTS_UNSUPPORTED_FUNCTION

# Non-DuckDB dialects should reject unsupported DuckDB cast target types.
statement error
SELECT sql FROM lpts_query('SELECT CAST(id AS HUGEINT) FROM users');
----
LPTS_UNSUPPORTED_TYPE

statement ok
SET lpts_dialect = 'bigquery';

statement error
SELECT sql FROM lpts_query('SELECT CAST(id AS SMALLINT) FROM users');
----
LPTS_UNSUPPORTED_TYPE

statement ok
SET lpts_dialect = 'postgres';

# TRY_CAST needs per-dialect rendering for dialects without TRY_CAST syntax.
statement error
SELECT sql FROM lpts_query('SELECT TRY_CAST(name AS INTEGER) FROM users');
----
LPTS_DIALECT_SEMANTIC_RISK

# Untyped NULL literals (SQLNULL) have no target-dialect cast type. They must render
# as a bare NULL, not CAST(NULL AS NULL) — which would trip the cast-type whitelist.
# Regression: the openivm to_date/to_timestamp shim expands to
# CAST(CASE WHEN s IS NOT NULL THEN NULL WHEN s IS NULL THEN NULL END AS DATE),
# whose CASE branches are untyped NULLs.
statement ok
SET lpts_dialect = 'spark';

statement ok
SELECT sql FROM lpts_query('SELECT CAST(CASE WHEN name IS NOT NULL THEN NULL WHEN name IS NULL THEN NULL END AS DATE) AS d FROM users');

query I
SELECT sql NOT LIKE '%AS NULL)%' AS no_null_type_cast
FROM lpts_query('SELECT CAST(CASE WHEN name IS NOT NULL THEN NULL WHEN name IS NULL THEN NULL END AS DATE) AS d FROM users');
----
true

# A bare untyped NULL projection also renders as NULL, not CAST(NULL AS NULL).
query I
SELECT sql NOT LIKE '%AS NULL)%' AS bare_null_ok FROM lpts_query('SELECT NULL AS n FROM users');
----
true

# Unknown date format tokens should not silently pass through converted format strings.
statement ok
SET lpts_dialect = 'spark';

statement error
SELECT sql FROM lpts_query('SELECT strftime(ts, ''%j'') FROM users');
----
LPTS_UNSUPPORTED_DATE_FORMAT_TOKEN

# Unsupported logical operators should use structured error codes.
statement ok
SET lpts_dialect = 'duckdb';

statement error
SELECT sql FROM lpts_query('UPDATE users SET id = id + 1');
----
LPTS_UNSUPPORTED_OPERATOR

statement error
SELECT sql FROM lpts_query('DELETE FROM users WHERE id = 1');
----
LPTS_UNSUPPORTED_OPERATOR

# MySQL/MariaDB should fail closed for FULL OUTER JOIN.
statement ok
SET lpts_dialect = 'mysql';

statement error
SELECT sql FROM lpts_query('SELECT * FROM users FULL OUTER JOIN users AS u2 ON users.id = u2.id');
----
LPTS_UNSUPPORTED_JOIN_TYPE

# Non-DuckDB dialects should fail closed for DuckDB-only join syntax.
statement ok
SET lpts_dialect = 'postgres';

statement error
SELECT sql FROM lpts_query('SELECT * FROM users POSITIONAL JOIN users AS u2');
----
LPTS_UNSUPPORTED_OPERATOR

statement ok
SET lpts_dialect = 'duckdb';
