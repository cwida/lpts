# name: test/sql/functions.test
# description: test lpts with scalar function calls (BOUND_FUNCTION expressions)
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE users (id INTEGER, name VARCHAR, age INTEGER);

statement ok
INSERT INTO users VALUES (1, 'Alice', 30), (2, 'Bob', 25), (3, 'Carol', 35), (4, 'dave', 22);

# --- length() in projection ---

query II rowsort
SELECT name, length(name) FROM users;
----
Alice	5
Bob	3
Carol	5
dave	4

statement ok
SELECT name, length(name) FROM users;

# --- upper() in projection: string to uppercase ---

query I rowsort
SELECT upper(name) FROM users;
----
ALICE
BOB
CAROL
DAVE

statement ok
SELECT upper(name) FROM users;

# --- lower() in projection ---

query I rowsort
SELECT lower(name) FROM users;
----
alice
bob
carol
dave

statement ok
SELECT lower(name) FROM users;

# --- length() in WHERE filter ---

query II rowsort
SELECT name, age FROM users WHERE length(name) > 3;
----
Alice	30
Carol	35
dave	22

statement ok
SELECT name, age FROM users WHERE length(name) > 3;

# --- upper() in projection + length() in WHERE filter combined ---

query II rowsort
SELECT upper(name), age FROM users WHERE length(name) > 3;
----
ALICE	30
CAROL	35
DAVE	22

statement ok
SELECT upper(name), age FROM users WHERE length(name) > 3;

# --- Arithmetic operator (+) as a scalar function in projection ---

query II rowsort
SELECT id, age + 1 FROM users;
----
1	31
2	26
3	36
4	23

statement ok
SELECT id, age + 1 FROM users;

# --- Arithmetic in filter: age - 5 > 20 ---

query I rowsort
SELECT name FROM users WHERE age - 5 > 20;
----
Alice
Carol

statement ok
SELECT name FROM users WHERE age - 5 > 20;

# --- Nested scalar function: upper(lower(name)) ---

statement ok
SELECT upper(lower(name)) FROM users;

# --- Scalar function on a constant: length(''hello'') ---

statement ok
SELECT length('hello') FROM users;

# --- Function applied to integer arithmetic: abs(age - 30) ---

statement ok
CREATE TABLE scores (player VARCHAR, score INTEGER);

statement ok
INSERT INTO scores VALUES ('P1', 100), ('P2', -50), ('P3', 0), ('P4', 75);

query II rowsort
SELECT player, abs(score) FROM scores;
----
P1	100
P2	50
P3	0
P4	75

statement ok
SELECT player, abs(score) FROM scores;

# --- Function in both projection and filter ---

query II rowsort
SELECT player, abs(score) FROM scores WHERE abs(score) > 60;
----
P1	100
P4	75

statement ok
SELECT player, abs(score) FROM scores WHERE abs(score) > 60;

# --- Function on NULL input: length(NULL) → NULL ---

statement ok
CREATE TABLE nullnames (name VARCHAR);

statement ok
INSERT INTO nullnames VALUES ('hello'), (NULL);

query I rowsort
SELECT length(name) FROM nullnames;
----
5
NULL

statement ok
SELECT length(name) FROM nullnames;

# ==========================================
# Table functions (range, generate_series)
# ==========================================

statement ok
SELECT * FROM range(1, 5);

statement ok
SELECT * FROM generate_series(1, 3);

statement ok
SELECT i FROM range(10) t(i) WHERE i > 5;

statement ok
SELECT a, b FROM range(1, 4) t1(a), range(10, 13) t2(b);

# --- struct_pack preserves named field names across round-trip ---

statement ok
SELECT struct_pack(name := name, n := age) FROM users;

statement ok
SELECT struct_pack(a := id, b := name, c := age) FROM users;
