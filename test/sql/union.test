# name: test/sql/union.test
# description: test lpts with UNION ALL queries
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE users (id INTEGER, name VARCHAR);

statement ok
CREATE TABLE orders (id INTEGER, user_id INTEGER, amount DECIMAL);

statement ok
CREATE TABLE staff (id INTEGER, dept VARCHAR, salary INTEGER);

statement ok
INSERT INTO users VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Carol');

statement ok
INSERT INTO orders VALUES (1, 1, 100.0), (2, 2, 200.0), (3, 1, 150.0);

statement ok
INSERT INTO staff VALUES (1, 'eng', 50000), (2, 'sales', 60000);

# --- UNION ALL same table: duplicates rows are preserved ---

query II rowsort
SELECT id, name FROM users UNION ALL SELECT id, name FROM users;
----
1	Alice
1	Alice
2	Bob
2	Bob
3	Carol
3	Carol

statement ok
SELECT id, name FROM users UNION ALL SELECT id, name FROM users;

# --- UNION ALL different tables with compatible schema ---

query II rowsort
SELECT id, name FROM users UNION ALL SELECT id, dept FROM staff;
----
1	Alice
1	eng
2	Bob
2	sales
3	Carol

statement ok
SELECT id, name FROM users UNION ALL SELECT id, dept FROM staff;

# --- UNION ALL with WHERE on each branch independently ---

query II rowsort
SELECT id, name FROM users WHERE id > 1 UNION ALL SELECT id, dept FROM staff WHERE salary > 55000;
----
2	Bob
2	sales
3	Carol

statement ok
SELECT id, name FROM users WHERE id > 1 UNION ALL SELECT id, dept FROM staff WHERE salary > 55000;

# --- UNION ALL where one branch is empty after filter ---

query II rowsort
SELECT id, name FROM users WHERE id > 100 UNION ALL SELECT id, dept FROM staff;
----
1	eng
2	sales

statement ok
SELECT id, name FROM users WHERE id > 100 UNION ALL SELECT id, dept FROM staff;

# --- UNION ALL where both branches produce data ---

statement ok
SELECT id FROM users UNION ALL SELECT id FROM orders;

# --- UNION ALL with JOIN on one branch ---

query II rowsort
SELECT u.id, u.name FROM users u INNER JOIN orders o ON u.id = o.user_id UNION ALL SELECT u.id, u.name FROM users u INNER JOIN orders o ON u.id = o.user_id;
----
1	Alice
1	Alice
1	Alice
1	Alice
2	Bob
2	Bob

statement ok
SELECT u.id, u.name FROM users u INNER JOIN orders o ON u.id = o.user_id UNION ALL SELECT u.id, u.name FROM users u INNER JOIN orders o ON u.id = o.user_id;

# --- UNION ALL with aggregate on top: group after combining both branches ---

query II rowsort
SELECT name, SUM(amount) FROM (SELECT u.name, o.amount FROM users u INNER JOIN orders o ON u.id = o.user_id UNION ALL SELECT u.name, o.amount FROM users u INNER JOIN orders o ON u.id = o.user_id) GROUP BY name;
----
Alice	500.0
Bob	400.0

statement ok
SELECT name, SUM(amount) FROM (SELECT u.name, o.amount FROM users u INNER JOIN orders o ON u.id = o.user_id UNION ALL SELECT u.name, o.amount FROM users u INNER JOIN orders o ON u.id = o.user_id) GROUP BY name;

# --- UNION ALL count: total row count is sum of both branches ---

query I
SELECT count(*) FROM (SELECT id FROM users UNION ALL SELECT id FROM staff);
----
5

statement ok
SELECT count(*) FROM (SELECT id FROM users UNION ALL SELECT id FROM staff);

# --- UNION ALL with filter on the aggregate result ---

statement ok
SELECT name, SUM(amount) FROM (SELECT u.name, o.amount FROM users u INNER JOIN orders o ON u.id = o.user_id UNION ALL SELECT u.name, o.amount FROM users u INNER JOIN orders o ON u.id = o.user_id) GROUP BY name HAVING SUM(amount) > 400;

# --- Three-way UNION ALL ---

statement ok
SELECT id FROM users UNION ALL SELECT id FROM staff UNION ALL SELECT id FROM orders;

# UNION ALL with duplicate column names (tests column_map scoping)
statement ok
SELECT u.id, u.name FROM users u INNER JOIN orders o ON u.id = o.user_id UNION ALL SELECT s.id, s.dept FROM staff s INNER JOIN orders o ON s.id = o.user_id;

# 3-way UNION ALL (N-ary, tests chaining in AstFlattener)
statement ok
SELECT id FROM users UNION ALL SELECT id FROM staff UNION ALL SELECT user_id FROM orders;

# 4-way UNION ALL
statement ok
CREATE TABLE extra (val INTEGER);

statement ok
INSERT INTO extra VALUES (99);

statement ok
SELECT id FROM users UNION ALL SELECT id FROM staff UNION ALL SELECT user_id FROM orders UNION ALL SELECT val FROM extra;

# --- N-ary UNION with aggregate on top (regression) ---
# The AstFlattener splits N-ary UNION into left-deep binary UNIONs and appends
# intermediate CTEs to cte_nodes. Parent operators must reference each child
# CTE by NAME — not by cte_nodes[child->idx] — because the intermediate insertion
# breaks the idx==vector-position invariant.
statement ok
SELECT COUNT(*) FROM (SELECT id FROM users UNION ALL SELECT id FROM staff UNION ALL SELECT user_id FROM orders) t;

statement ok
SELECT id, COUNT(*) FROM (SELECT id FROM users UNION ALL SELECT id FROM staff UNION ALL SELECT user_id FROM orders) t GROUP BY id;

# --- N-ary UNION (implicit DISTINCT) with aggregate on top ---
statement ok
SELECT COUNT(*) FROM (SELECT id FROM users UNION SELECT id FROM staff UNION SELECT user_id FROM orders) t;

# --- Plain N-ary UNION (implicit DISTINCT) ---
statement ok
SELECT id FROM users UNION SELECT id FROM staff UNION SELECT user_id FROM orders;
