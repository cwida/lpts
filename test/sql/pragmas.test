# name: test/sql/pragmas.test
# description: test lpts pragmas (lpts_exec, lpts_check)
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE t (id INT, val INT);

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30);

# --- lpts_exec: SELECT * round-trip returns identical rows ---

query II rowsort
SELECT * FROM t;
----
1	10
2	20
3	30

# --- lpts_exec: aggregate round-trip returns correct sums ---

query II rowsort
SELECT id, sum(val) FROM t GROUP BY id;
----
1	10
2	20
3	30

# --- lpts_exec: filter round-trip ---

query II rowsort
SELECT id, val FROM t WHERE val > 10;
----
2	20
3	30

# --- lpts_exec: returns empty on no match ---

query II
SELECT id, val FROM t WHERE val > 9999;
----

# --- lpts_check: basic round-trip returns true ---

statement ok
SELECT * FROM t;

statement ok
SELECT id, sum(val) FROM t GROUP BY id;

# --- lpts_check with JOIN ---

statement ok
CREATE TABLE a (x INT);

statement ok
CREATE TABLE b (x INT);

statement ok
INSERT INTO a VALUES (1), (2), (3);

statement ok
INSERT INTO b VALUES (2), (3), (4);

statement ok
SELECT * FROM a;

statement ok
SELECT a.x FROM a JOIN b ON a.x = b.x;

# --- lpts_check: UNION ALL ---

statement ok
SELECT x FROM a UNION ALL SELECT x FROM b;

# --- lpts_check: consistent after INSERT ---

statement ok
INSERT INTO a VALUES (99);

statement ok
SELECT * FROM a;

statement ok
DELETE FROM a WHERE x = 99;

# --- lpts_check after DELETE: still true ---

statement ok
SELECT * FROM a;

# --- lpts_check: empty table ---

statement ok
CREATE TABLE empty_t (id INT, val INT);

statement ok
SELECT * FROM empty_t;

statement ok
SELECT count(*) FROM empty_t;

# --- lpts_exec: single-row table ---

statement ok
CREATE TABLE single (x INT);

statement ok
INSERT INTO single VALUES (42);

query I
SELECT * FROM single;
----
42

statement ok
SELECT * FROM single;

# --- lpts_exec: NULL values survive round-trip ---

statement ok
CREATE TABLE nullable (id INT, val INT);

statement ok
INSERT INTO nullable VALUES (1, NULL), (2, 5), (3, NULL);

query II rowsort
SELECT id, val FROM nullable;
----
1	NULL
2	5
3	NULL

statement ok
SELECT id, val FROM nullable;

# --- lpts_check: complex query with WHERE + GROUP BY + ORDER BY ---

statement ok
CREATE TABLE events (user_id INT, event_type VARCHAR, score INT);

statement ok
INSERT INTO events VALUES
  (1, 'click', 10), (1, 'view', 5), (2, 'click', 20),
  (2, 'click', 15), (3, 'view', 8);

statement ok
SELECT user_id, sum(score) FROM events WHERE event_type = 'click' GROUP BY user_id;

statement ok
SELECT user_id, count(*) FROM events GROUP BY user_id;

# --- lpts_check: original SQL may include a semicolon followed by a trailing comment ---

statement ok
SELECT id FROM t ORDER BY id; -- trailing SQLStorm comment;

# --- function metadata: public LPTS functions have descriptions and examples ---

query I
SELECT count(*)
FROM duckdb_functions()
WHERE function_name IN (
  'lpts',
  'lpts_query',
  'print_ast',
  'print_ast_query',
  'lpts_normalize_query'
)
AND description IS NOT NULL
AND len(examples) > 0;
----
5
