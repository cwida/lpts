# name: test/sql/fail_reduction.test
# description: Regression tests for rendering bugs that made LPTS emit invalid SQL (queries that FAILed
# group: [sql]

#   the round-trip check with Binder/Parser errors instead of translating). Each section names its bug.

require lpts

require parquet

require icu

require json

statement ok
SET lpts_check = true;

# --- DISTINCT aggregates over collated values retain their semantic collation through UNNEST. DuckDB 2.0
# can leave the source collation on the optimized column while carrying an explicit comparison collation on
# a folded constant; render that comparison under one common collation rather than emitting incompatible
# operand types. ---
query I
SELECT count(*)
FROM (SELECT unnest(list(DISTINCT s COLLATE de)) AS s
      FROM (VALUES ('ä'), ('ä'), ('Z')) t(s)) result
WHERE s COLLATE "binary" IN ('ä', 'ä', 'Z');
----
2

# --- Dummy-scan column naming: an uncorrelated IN/ANY/ALL over constants passes the dummy binding
# through the mark join; its registered name must match the CTE header (t0_dummy, not t0_1). ---
query I
SELECT (1 = ANY(SELECT 1));
----
true

# A nested SQLNULL type is valid DuckDB cast syntax and is not a no-op: TRY_CAST to a map with NULL
# key/value types converts non-empty maps to NULL while retaining the empty map.
query I
SELECT TRY_CAST(x AS MAP("NULL", "NULL"))
FROM (VALUES ('{1=1}'), ('{}'), (NULL)) t(x);
----
NULL
{}
NULL

statement ok
CREATE TABLE strings(v VARCHAR);

statement ok
INSERT INTO strings VALUES ('hello'), (NULL);

query I
SELECT 'bla' IN (SELECT * FROM strings);
----
NULL

# --- Multi-condition mark join without equality (row != / = ALL): executes as a nested-loop join whose
# conditions match INDEPENDENTLY (per-condition OR) — not the hash join's per-row AND. ---
query I
SELECT (1, 2) = ALL(SELECT * FROM (VALUES (1, 2), (1, 3)));
----
false

query I
SELECT (1, 2) != ANY(SELECT * FROM (VALUES (1, 2), (1, 3)));
----
true

# --- Unnamed-struct (ROW) constants: STRUCT(INTEGER, INTEGER) has no SQL syntax; the value is rebuilt
# as row(...) / nested constructors (also covers list_zip's STRUCT(<type>)[] entries). ---
query I
SELECT (0, 0) < ANY(SELECT 1, 0);
----
true

query I
SELECT list_zip(['2021-08-20'::DATE]);
----
[(2021-08-20,)]

# Fixed-size ARRAY values have distinct type/value accessors from LIST in DuckDB 2.0. Exercise both a
# direct constructor and a nested array so type inspection and structural constant rendering round-trip.
query I
SELECT array_value(1, 2, 3);
----
[1, 2, 3]

query I
SELECT array_value(array_value(1, 2), array_value(3, 4));
----
[[1, 2], [3, 4]]

# --- date_part struct variant: the constant part-list argument is erased at bind time and must be
# rebuilt from the STRUCT return type's field names. ---
query I
SELECT DATE_PART(['year','month','day'], DATE '2020-03-04');
----
{'year': 2020, 'month': 3, 'day': 4}

# --- MAP constants have no bare literal (display form {k=v}); rendered as CAST('<text>' AS MAP(...)). ---
query I
SELECT MAP{'k': 'v'};
----
{k=v}

# --- Slice bounds: an omitted bound is a sentinel constant of the list's own type; only the bracket
# syntax (with the `-` end marker when a step is present) can express it. list_reverse compiles to a
# full-range step -1 slice. ---
statement ok
CREATE TABLE lists(s INT[]);

statement ok
INSERT INTO lists VALUES ([1,2,3,4,5]);

query II
SELECT s[:2], s[2:] FROM lists;
----
[1, 2]	[2, 3, 4, 5]

query I
SELECT s[2:-:2] FROM lists;
----
[2, 4]

# --- DuckDB 2.0 nested schemas: preserve every schema-path component instead of retaining only the leaf. ---
statement ok
CREATE SCHEMA outer_schema;

statement ok
CREATE SCHEMA outer_schema.inner_schema;

statement ok
CREATE TABLE outer_schema.inner_schema.nested_values(i INTEGER);

statement ok
INSERT INTO outer_schema.inner_schema.nested_values VALUES (11), (22);

query I rowsort
SELECT i FROM outer_schema.inner_schema.nested_values;
----
11
22

# --- lpts_check must not execute sequence reads/writes twice while comparing a rewritten query. ---
statement ok
CREATE SEQUENCE checker_sequence START 41;

query I
SELECT nextval('checker_sequence');
----
41

query I
SELECT currval('checker_sequence');
----
41

query II
SELECT array_pop_back(s), list_reverse(s) FROM lists;
----
[1, 2, 3, 4]	[5, 4, 3, 2, 1]

# --- Quantile arguments live in bind data, both for window functions and list_aggr sub-aggregates. ---
statement ok
CREATE TABLE t1(id INT, ch VARCHAR);

statement ok
INSERT INTO t1 VALUES (1,'a'),(2,'a'),(3,'b'),(4,'b');

query II
SELECT id, quantile_cont(id, 0.5) OVER (PARTITION BY ch ORDER BY id ROWS BETWEEN 1 FOLLOWING AND 2 FOLLOWING) FROM t1 ORDER BY 1;
----
1	2.0
2	NULL
3	4.0
4	NULL

query I
SELECT list_aggr(list(i ORDER BY i), 'quantile', 0.5) FROM range(1, 11) tbl(i);
----
5

# --- Named-argument functions re-emit each child's alias as `name := expr`. ---
statement ok
CREATE TABLE stbl(col STRUCT(i INT));

statement ok
INSERT INTO stbl VALUES ({'i': 1});

query I
SELECT struct_insert(col, a := col.i + 1, b := NULL::VARCHAR) FROM stbl;
----
{'i': 1, 'a': 2, 'b': NULL}

query I
SELECT struct_update(col, i := 99) FROM stbl;
----
{'i': 99}

# --- EXPORT_STATE aggregates: the internal aggregate_state_export_<f> name is re-emitted as
# `(<f>(args) EXPORT_STATE)` — parenthesized so it survives inside function argument lists. ---
query I
SELECT (SUM(42) EXPORT_STATE) IS NOT NULL;
----
true

statement ok
CREATE TABLE dummy AS SELECT 42::DOUBLE d;

query I
SELECT FINALIZE(COMBINE(SUM(d) EXPORT_STATE, SUM(d) EXPORT_STATE)) FROM dummy;
----
84.0

statement ok
CREATE TABLE avg_states AS SELECT AVG(d) EXPORT_STATE state FROM dummy;

# Filter pushdown must not replace an empty state-bearing scan with DuckDB's metadata-free legacy
# AGGREGATE_STATE placeholder; without the signature, no valid SQL cast can reconstruct the state.
query I
SELECT FINALIZE(COMBINE_AGGR(state)) FROM avg_states WHERE false;
----
NULL

# Raw aggregate-state values have representation-dependent payloads, so lpts_check cannot compare them.
# Folded aggregate-state constants remain serializable because DuckDB retains the aggregate signature in type metadata.
statement error
SELECT SUM(d) EXPORT_STATE FROM dummy;
----
LPTS_UNSUPPORTED_CHECK_TYPE

query I
SELECT FINALIZE(COMBINE_AGGR(TO_AGGREGATE_STATE(NULL::BIGINT, 'count', ['ANY'])));
----
0

# --- OpenIVM-shaped aggregate-state plan: a deep projected expression feeds a collated aggregate with
# FILTER/EXPORT_STATE, then crosses CTE boundaries and is rebound from its TYPE[] signature. The macros
# double the retained expression at each level, producing 64 nested calls without a generated SQL fixture.
statement ok
SET max_expression_depth = 1000;

statement ok
CREATE MACRO ivm_deep_1(x) AS concat('[', x, ']');

statement ok
CREATE MACRO ivm_deep_2(x) AS ivm_deep_1(ivm_deep_1(x));

statement ok
CREATE MACRO ivm_deep_3(x) AS ivm_deep_2(ivm_deep_2(x));

statement ok
CREATE MACRO ivm_deep_4(x) AS ivm_deep_3(ivm_deep_3(x));

statement ok
CREATE MACRO ivm_deep_5(x) AS ivm_deep_4(ivm_deep_4(x));

statement ok
CREATE MACRO ivm_deep_6(x) AS ivm_deep_5(ivm_deep_5(x));

statement ok
CREATE MACRO ivm_deep_7(x) AS ivm_deep_6(ivm_deep_6(x));

statement ok
CREATE TABLE ivm_state_input(g INTEGER, s VARCHAR, openivm_multiplicity INTEGER);

statement ok
INSERT INTO ivm_state_input VALUES (1, 'a', 1), (1, 'Z', 1), (1, 'ignored', -1), (2, 'b', 1);

query III rowsort
WITH ivm_delta AS (
    SELECT g, ivm_deep_7(s) COLLATE NOCASE AS normalized, openivm_multiplicity
    FROM ivm_state_input
), ivm_state AS (
    SELECT g, max(normalized COLLATE NOCASE)
                  FILTER (WHERE openivm_multiplicity > 0) EXPORT_STATE AS state
    FROM ivm_delta
    GROUP BY g
), ivm_rebound AS (
    SELECT g, state, to_aggregate_state(state, 'arg_max',
        [get_type(NULL::VARCHAR COLLATE NOCASE), get_type(NULL::VARCHAR COLLATE NOCASE)]) AS rebound
    FROM ivm_state
)
SELECT g,
       length(finalize(combine(state, rebound))),
       contains(finalize(combine(state, rebound)), CASE WHEN g = 1 THEN 'Z' ELSE 'b' END)
FROM ivm_rebound
ORDER BY g;
----
1	129	true
2	129	true

# Exported collated aggregate states retain the function's logical argument types even when the value
# argument is a bare column whose source table itself is uncollated.
query TI
SELECT finalize(combine(state, rebound)), finalize(combine(state, rebound)) = 'z'
FROM (
    SELECT state, to_aggregate_state(state, 'arg_max',
        [get_type(NULL::VARCHAR COLLATE NOCASE), get_type(NULL::VARCHAR COLLATE NOCASE)]) AS rebound
    FROM (SELECT max(s COLLATE NOCASE) EXPORT_STATE AS state FROM ivm_state_input)
);
----
Z	true

# --- rowid: a filter on the virtual rowid column is keyed by the virtual column id (not an index into
# the scan's names) and round-trips faithfully over the same base table. ---
statement ok
CREATE TABLE rid(x INT);

statement ok
INSERT INTO rid VALUES (7),(8);

query I
SELECT * FROM rid WHERE rowid = 0;
----
7

# --- list_reduce: the lambda is inserted at its declared argument position (before a trailing initial
# value), and body references render under the canonical parameter name. ---
query I
SELECT list_reduce([1,2,3], lambda x, y: x + y, 100);
----
106

statement ok
CREATE TABLE fruit_tbl(fruits VARCHAR[]);

statement ok
INSERT INTO fruit_tbl VALUES (['apple','banana','cherry']);

query I
SELECT [fruit for fruit in fruits if contains(fruit, 'an')] FROM fruit_tbl;
----
[banana]

# --- Recursive-CTE column dedup: an anchor projecting one source column into two outputs must not
# declare duplicate CTE header columns. ---
query II
SELECT x, y FROM generate_series(1,2) AS _(x), LATERAL (WITH RECURSIVE t(y) AS MATERIALIZED (SELECT _.x UNION SELECT y + 1 FROM t WHERE y < 3) SELECT * FROM t) AS t ORDER BY x, y;
----
1	1
1	2
1	3
2	2
2	3

# --- Deep recursive UNNEST: one UNNEST level per CTE (fusing two levels would nest UNNEST calls). ---
query I
SELECT UNNEST([[[1, 2], [3]], [[4]]], recursive := true) ORDER BY 1;
----
1
2
3
4

# --- NUL bytes: representable in string values via chr(0) concatenation. ---
statement ok
CREATE TABLE varchars(v VARCHAR);

statement ok
INSERT INTO varchars VALUES ('hello' || chr(0)), ('x');

query I
SELECT count(*) FROM varchars WHERE v = 'hello' || chr(0);
----
1

# --- Constant ORDER BY keys (a folded alias like `10 AS j` in ORDER BY) are dropped: DuckDB re-reads a
# bare (even parenthesized) integer as an ordinal, and ordering by a constant is a no-op. ---
statement ok
CREATE TABLE oint(i INT);

statement ok
INSERT INTO oint VALUES (3),(1),(2);

query II
SELECT 10 AS j, i FROM oint ORDER BY j, i NULLS LAST;
----
10	1
10	2
10	3

# A user-written cast can fold to a non-integer constant in the optimized ORDER BY. The key has no
# ordering effect and must be removed rather than rebound as a rejected bare literal.
query I
SELECT i FROM oint ORDER BY CAST('a' AS VARCHAR), i;
----
1
2
3

# --- UNION-typed constants rebuild via union_value(tag := v) cast to the full union type. ---
query I
SELECT [true::UNION(a integer, c bool)] AS u FROM range(2);
----
[true]
[true]

# DuckDB 2.0 retains function-level named arguments independently of child aliases.
query I rowsort
SELECT union_extract(union_value("Member" := i), 'Member') FROM oint;
----
1
2
3

# Context-polymorphic error() branches in a scalar-subquery cardinality check need their VARCHAR cast
# before COLLATE is reapplied.
statement ok
CREATE TABLE collated_scalar(v VARCHAR);

statement ok
INSERT INTO collated_scalar VALUES ('XXX');

query I
SELECT (SELECT v FROM collated_scalar) COLLATE NOCASE;
----
XXX

# Empty ENUMs are valid named catalog types but have no inline ENUM() spelling. Refuse the folded
# constant with a coded unsupported result instead of emitting SQL that fails in the binder.
statement ok
CREATE TYPE lpts_empty_enum AS ENUM ();

statement error
SELECT * FROM lpts_query('SELECT NULL::lpts_empty_enum');
----
LPTS_UNSUPPORTED_TYPE

# Keep a projection boundary around fallible expressions. Folding the constant-producing CTE into
# json_extract changes DuckDB's dynamic-path runtime error into a binder error.
query I
SELECT sql LIKE '%projection_%' AND sql LIKE '%json_extract(%'
FROM lpts_query($$
WITH tbl AS (
    SELECT '[{"duck":42},{"duck":43}]' j, '$[*].duck' p
)
SELECT json_extract(j, p) FROM tbl
$$);
----
true

statement ok
SET lpts_check = true;

statement error
WITH tbl AS (
    SELECT '[{"duck":42},{"duck":43}]' j, '$[*].duck' p
)
SELECT json_extract(j, p) FROM tbl;
----
Invalid Input Error

statement ok
SET lpts_check = false;

# --- TYPE-typed constants (get_type/make_type) reconstruct as get_type(CAST(NULL AS <type>)). ---
query II
SELECT get_type(1), get_type('x');
----
INTEGER	VARCHAR

# --- Set operation whose branch keeps an inner ORDER BY key as an extra projected column: the branch
# must select only the union's arity, not `*`. ---
statement ok
CREATE TABLE sotest(a INT);

statement ok
INSERT INTO sotest VALUES (2),(1);

statement ok
CREATE TABLE sotest2(b INT);

statement ok
INSERT INTO sotest2 VALUES (3);

query I
(SELECT a FROM sotest ORDER BY a+1) UNION SELECT b FROM sotest2 ORDER BY 1;
----
1
2
3

# --- A projection that duplicates a UNION ALL key must render both aliases from the set-op output,
# not a stale child binding from one branch. Closest SQL shape to the OpenIVM hidden-left-key rewrite. ---
statement ok
CREATE TABLE isf_bugf(instance_arm_collection_key INT, event_time INT);

statement ok
INSERT INTO isf_bugf VALUES (1, 10), (2, 20);

statement ok
CREATE TABLE acd_bugf(arm_collection_key INT, subscription_id INT, arm_id VARCHAR, rn INT);

statement ok
INSERT INTO acd_bugf VALUES (1, 100, 'arm-1', 1), (2, 200, 'arm-2', 1);

statement ok
CREATE TABLE imlmv_bugf(instance_arm_id VARCHAR, container_resource_id VARCHAR);

statement ok
INSERT INTO imlmv_bugf VALUES ('arm-1', 'machine-1');

statement ok
CREATE TABLE cores_bugf(instance_arm_id VARCHAR, instance_effective_cores DOUBLE);

statement ok
INSERT INTO cores_bugf VALUES ('arm-1', 4.0), ('arm-2', 8.0);

query TT rowsort
WITH base_filtered_fact AS (
    SELECT isf.event_time, acd.subscription_id, acd.arm_id AS instance_arm_id,
           lower(coalesce(imlmv.container_resource_id, 'NA')) AS container_resource_id
    FROM isf_bugf isf
    INNER JOIN (SELECT arm_collection_key, subscription_id, arm_id FROM acd_bugf WHERE rn = 1) AS acd
      ON isf.instance_arm_collection_key = acd.arm_collection_key
    LEFT JOIN imlmv_bugf imlmv ON acd.arm_id = imlmv.instance_arm_id
),
keyed AS (
    SELECT bff.event_time, bff.subscription_id, bff.instance_arm_id, bff.container_resource_id,
           coalesce(cores.instance_effective_cores, 0.0) AS instance_effective_cores
    FROM base_filtered_fact AS bff
    LEFT JOIN cores_bugf cores ON bff.instance_arm_id = cores.instance_arm_id
    WHERE lower(bff.container_resource_id) <> lower('NA') OR bff.container_resource_id IS NULL
),
no_machine AS (
    SELECT bff.event_time, bff.subscription_id, bff.instance_arm_id, bff.container_resource_id,
           coalesce(cores.instance_effective_cores, 0.0) AS instance_effective_cores
    FROM base_filtered_fact AS bff
    LEFT JOIN cores_bugf cores ON bff.instance_arm_id = cores.instance_arm_id
    WHERE lower(bff.container_resource_id) = lower('NA')
)
SELECT combined.instance_arm_id AS instance_arm_id, combined.instance_arm_id AS openivm_left_key
FROM (
    SELECT keyed.subscription_id, keyed.instance_arm_id, keyed.instance_effective_cores FROM keyed
    UNION ALL
    SELECT no_machine.subscription_id, no_machine.instance_arm_id, no_machine.instance_effective_cores FROM no_machine
) combined
ORDER BY 1, 2;
----
arm-1	arm-1
arm-2	arm-2

query I
SELECT regexp_extract(sql,
                      '(?s).*SELECT\\s+([^ ,]+) AS instance_arm_id,\\s+([^ ,]+) AS openivm_left_key.*',
                      1) =
       regexp_extract(sql,
                      '(?s).*SELECT\\s+([^ ,]+) AS instance_arm_id,\\s+([^ ,]+) AS openivm_left_key.*',
                      2)
FROM lpts_query($$
WITH base_filtered_fact AS (
    SELECT isf.event_time, acd.subscription_id, acd.arm_id AS instance_arm_id,
           lower(coalesce(imlmv.container_resource_id, 'NA')) AS container_resource_id
    FROM isf_bugf isf
    INNER JOIN (SELECT arm_collection_key, subscription_id, arm_id FROM acd_bugf WHERE rn = 1) AS acd
      ON isf.instance_arm_collection_key = acd.arm_collection_key
    LEFT JOIN imlmv_bugf imlmv ON acd.arm_id = imlmv.instance_arm_id
),
keyed AS (
    SELECT bff.event_time, bff.subscription_id, bff.instance_arm_id, bff.container_resource_id,
           coalesce(cores.instance_effective_cores, 0.0) AS instance_effective_cores
    FROM base_filtered_fact AS bff
    LEFT JOIN cores_bugf cores ON bff.instance_arm_id = cores.instance_arm_id
    WHERE lower(bff.container_resource_id) <> lower('NA') OR bff.container_resource_id IS NULL
),
no_machine AS (
    SELECT bff.event_time, bff.subscription_id, bff.instance_arm_id, bff.container_resource_id,
           coalesce(cores.instance_effective_cores, 0.0) AS instance_effective_cores
    FROM base_filtered_fact AS bff
    LEFT JOIN cores_bugf cores ON bff.instance_arm_id = cores.instance_arm_id
    WHERE lower(bff.container_resource_id) = lower('NA')
)
SELECT combined.instance_arm_id AS instance_arm_id, combined.instance_arm_id AS openivm_left_key
FROM (
    SELECT keyed.subscription_id, keyed.instance_arm_id, keyed.instance_effective_cores FROM keyed
    UNION ALL
    SELECT no_machine.subscription_id, no_machine.instance_arm_id, no_machine.instance_effective_cores FROM no_machine
) combined
$$);
----
true

# --- A pushed-down filter on a column that is NOT projected (filter-only) must still resolve through
# the table-function alias. ---
query I
SELECT last_name FROM parquet_scan('duckdb/data/parquet-testing/userdata1.parquet') WHERE first_name='Amanda' ORDER BY last_name LIMIT 3;
----
Clark
Coleman
Franklin

# A COUNT(*) scan may retain only DuckDB's synthetic rowid binding, while a pushed-down filter still
# names a real table-function output through the user's positional aliases. Keep the complete function
# alias instead of replacing it with `_tf(rowid)`.
statement ok
COPY (SELECT * FROM (VALUES (1, 7), (2, 9), (3, 7)) t(id, part))
TO '{TEST_DIR}/lpts_filter_alias.parquet' (FORMAT parquet);

query I
SELECT count(*)
FROM read_parquet('{TEST_DIR}/lpts_filter_alias.parquet') AS t(a, b)
WHERE b = 7;
----
2

# --- LATERAL <table function> WITH ORDINALITY: the ordinality column is part of the scan output, and
# the correlated passthrough columns are the child's own bindings. ---
statement ok
CREATE TABLE lat_t(a INT);

statement ok
INSERT INTO lat_t VALUES (2),(3);

query III
SELECT a, my_range, my_ordinality FROM lat_t AS t(a), LATERAL range(t.a) WITH ORDINALITY AS _(my_range, my_ordinality) ORDER BY 1,2,3;
----
2	0	1
2	1	2
3	0	1
3	1	2
3	2	3

# --- ... also inside a recursive CTE step (rendered as inline SQL with the delim source inlined). ---
query I
WITH RECURSIVE ordinalityCTE AS (SELECT 1 AS ordinality UNION SELECT oCTE.ordinality + r.ordinality AS ordinality FROM ordinalityCTE AS oCTE, LATERAL range(oCTE.ordinality) WITH ORDINALITY AS r(range,ordinality) WHERE oCTE.ordinality < 3) SELECT ordinality FROM ordinalityCTE ORDER BY ordinality;
----
1
2
3
4

# --- TABLE-argument functions (`summary((SELECT ...))`) embed the child as the argument. ---
statement ok
CREATE TABLE sumtbl(x INT, j INT);

statement ok
INSERT INTO sumtbl VALUES (1, 2);

query III
SELECT * FROM summary((SELECT * FROM sumtbl));
----
[1, 2]	1	2

# --- RANGE frames with INTERVAL offsets: the plan stores `<order key> - <offset>` with casts that can
# differ between ORDER BY and frame expression; the offset is recovered modulo casts. ---
statement ok
CREATE TABLE power(plant VARCHAR, date DATE, mwh INT);

statement ok
INSERT INTO power VALUES ('a','2020-01-01',10),('a','2020-01-03',20),('a','2020-01-08',30),('b','2020-01-01',5);

query III
SELECT * FROM (SELECT plant, date, avg(mwh) OVER (PARTITION BY plant ORDER BY date ASC RANGE BETWEEN INTERVAL 3 DAYS PRECEDING AND INTERVAL 3 DAYS FOLLOWING) AS avgmwh FROM power ORDER BY plant, avgmwh DESC) QUALIFY row_number() OVER (PARTITION BY plant ORDER BY avgmwh DESC) = 1 ORDER BY plant;
----
a	2020-01-08	30.0
b	2020-01-01	5.0

# --- Preserve DuckDB's native MARK semantics for nested comparison values. A whole STRUCT can be
# non-NULL while one of its fields still makes an inequality comparison indeterminate. ---
query I
SELECT __mark_join_marker FROM (VALUES (row(1,2))) p(c) JOIN BY(TYPE MARK) (VALUES (row(1,NULL::INT))) b(d) ON c <> d;
----
NULL

# --- EXCEPT/INTERSECT comparison semantics come from the set operation's output collation even when
# DuckDB's optimizer has removed the original COLLATE projection. ---
statement ok
CREATE TABLE lpts_collate_left(s VARCHAR);

statement ok
CREATE TABLE lpts_collate_right(s VARCHAR);

statement ok
INSERT INTO lpts_collate_left VALUES ('a');

statement ok
INSERT INTO lpts_collate_right VALUES ('A');

query I
SELECT count(*) FROM ((SELECT s COLLATE NOCASE FROM lpts_collate_left) EXCEPT (SELECT s FROM lpts_collate_right));
----
0

query I
SELECT count(*) FROM ((SELECT s COLLATE NOCASE FROM lpts_collate_left) INTERSECT (SELECT s FROM lpts_collate_right));
----
1

# --- ColumnDataCollection scans retain their original column-id mapping after unused-column pruning. ---
statement ok
CREATE TABLE lpts_chunk_projection AS FROM (VALUES (ROW(3)));

query T
SELECT column_type FROM (DESCRIBE lpts_chunk_projection);
----
TUPLE(INTEGER)

# --- A fully pruned ColumnDataCollection is a zero-column relation, but its row multiplicity remains visible. ---
query I
SELECT count(*) FROM (DESCRIBE SELECT 1 AS a, 2 AS b, 3 AS c);
----
3

# --- Comparison-join operands retain their expression boundaries. ---
query I
SELECT count(*)
FROM (VALUES (0::INTEGER, NULL::INTEGER)) l(a, b)
JOIN (VALUES (false)) r(c)
  ON (l.a = l.b OR (l.a IS NULL AND l.b IS NULL)) = r.c;
----
0

# Pipeline fusion must not inline a projected integer constant into GROUP BY, where SQL would reinterpret
# it as an ordinal. This nested lateral shape creates that plan during decorrelation.
query II
SELECT *
FROM (SELECT 42 AS c1) AS ref,
     (SELECT a + b + 1
      FROM (SELECT 1) t1(a),
           (SELECT (SELECT (SELECT ref.c1 + 1)) + 1) t2(b));
----
42	46

# Native UNION quantifiers retain group metadata that explicit MARK syntax cannot reconstruct. Keep the
# portable correlated lowering for that plan shape.
statement ok
CREATE TABLE lpts_union_probes(g INTEGER, u UNION(i INTEGER, s VARCHAR));

statement ok
INSERT INTO lpts_union_probes VALUES (0, union_value(i := 1)), (1, union_value(i := 2)), (2, NULL);

statement ok
CREATE TABLE lpts_union_candidates(g INTEGER, u UNION(i INTEGER, s VARCHAR));

statement ok
INSERT INTO lpts_union_candidates VALUES (0, union_value(i := 1)), (1, union_value(i := NULL));

query II rowsort
SELECT g, u = ANY(SELECT c.u FROM lpts_union_candidates c WHERE c.g = p.g)
FROM lpts_union_probes p;
----
0	true
1	false
2	false

# --- Constant ORDER BY keys are omitted inside aggregates and windows as well as top-level ordering. ---
statement ok
CREATE TABLE lpts_constant_order(s VARCHAR, i INTEGER);

statement ok
INSERT INTO lpts_constant_order VALUES ('b', 1), ('a', 2);

query I
SELECT list(s ORDER BY NULL || s, s) FROM lpts_constant_order;
----
[a, b]

query II rowsort
SELECT s, count(*) OVER (ORDER BY NULL || s GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW)
FROM lpts_constant_order;
----
a	2
b	2

# --- RANGE endpoints reverse their arithmetic under DESC and fold zero offsets to the order key. ---
query II rowsort
SELECT x, sum(x) OVER (ORDER BY x DESC RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING)
FROM (VALUES (1), (2), (2), (4), (NULL)) t(x);
----
1	5
2	5
2	5
4	8
NULL	NULL

query IIII rowsort
WITH t(id, k) AS (VALUES (1, 1), (2, 1))
SELECT id,
       sum(1) OVER (ORDER BY k RANGE BETWEEN CURRENT ROW AND CURRENT ROW),
       sum(1) OVER (ORDER BY k RANGE BETWEEN 0 PRECEDING AND 0 PRECEDING),
       sum(1) OVER (ORDER BY k RANGE BETWEEN 0 FOLLOWING AND 0 FOLLOWING)
FROM t;
----
1	2	2	2
2	2	2	2

# Numeric comparison constants rebind to the peer's exact type without explicit CAST wrappers, keeping
# wide n-ary conjunctions below DuckDB's configured expression-depth limit.
statement ok
SET max_expression_depth = 10;

query I
FROM query('SELECT count(*) FROM lpts_constant_order WHERE i < 1' ||
           repeat(' OR i < 50 AND i >= 0', 49));
----
2

statement ok
SET max_expression_depth = 1000;

statement ok
SET lpts_check = false;
