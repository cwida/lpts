# name: test/sql/cast.test
# description: test lpts with CAST and TRY_CAST expressions
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE nums (val VARCHAR, n INTEGER);

statement ok
INSERT INTO nums VALUES ('42', 1), ('7', 2), ('100', 3), ('-5', 4);

# --- CAST in projection: VARCHAR → INTEGER ---

query I rowsort
SELECT CAST(val AS INTEGER) FROM nums;
----
-5
100
42
7

statement ok
SELECT CAST(val AS INTEGER) FROM nums;

# --- CAST in projection: INTEGER → VARCHAR ---

query I rowsort
SELECT CAST(n AS VARCHAR) FROM nums;
----
1
2
3
4

statement ok
SELECT CAST(n AS VARCHAR) FROM nums;

# --- CAST in projection: VARCHAR → BIGINT ---

statement ok
SELECT CAST(val AS BIGINT) FROM nums;

# --- CAST in projection: VARCHAR → DOUBLE ---

statement ok
SELECT CAST(val AS DOUBLE) FROM nums;

# --- CAST in WHERE filter: comparison on cast value ---

query II rowsort
SELECT val, n FROM nums WHERE CAST(val AS INTEGER) > 10;
----
100	3
42	1

statement ok
SELECT val, n FROM nums WHERE CAST(val AS INTEGER) > 10;

# --- CAST filter with negative values ---

query II rowsort
SELECT val, n FROM nums WHERE CAST(val AS INTEGER) < 0;
----
-5	4

statement ok
SELECT val, n FROM nums WHERE CAST(val AS INTEGER) < 0;

# --- CAST used in both projection and filter ---

query I rowsort
SELECT CAST(val AS INTEGER) FROM nums WHERE CAST(val AS INTEGER) >= 7;
----
100
42
7

statement ok
SELECT CAST(val AS INTEGER) FROM nums WHERE CAST(val AS INTEGER) >= 7;

# --- TRY_CAST: successful conversion returns the value ---

query I rowsort
SELECT TRY_CAST(val AS DOUBLE) FROM nums;
----
-5.0
100.0
42.0
7.0

statement ok
SELECT TRY_CAST(val AS DOUBLE) FROM nums;

# --- TRY_CAST: invalid conversion returns NULL instead of throwing ---

statement ok
CREATE TABLE mixed_vals (raw VARCHAR);

statement ok
INSERT INTO mixed_vals VALUES ('123'), ('not_a_number'), ('456'), (NULL);

query I rowsort
SELECT TRY_CAST(raw AS INTEGER) FROM mixed_vals;
----
123
456
NULL
NULL

statement ok
SELECT TRY_CAST(raw AS INTEGER) FROM mixed_vals;

# --- TRY_CAST in WHERE filter: NULLs from failed casts are excluded ---

query I rowsort
SELECT raw FROM mixed_vals WHERE TRY_CAST(raw AS INTEGER) > 200;
----
456

statement ok
SELECT raw FROM mixed_vals WHERE TRY_CAST(raw AS INTEGER) > 200;

# --- CAST on NULL input produces NULL ---

statement ok
CREATE TABLE null_cast (val VARCHAR);

statement ok
INSERT INTO null_cast VALUES (NULL);

query I
SELECT CAST(val AS INTEGER) FROM null_cast;
----
NULL

statement ok
SELECT CAST(val AS INTEGER) FROM null_cast;

# --- Nested CAST: CAST(CAST(val AS INTEGER) AS VARCHAR) ---

statement ok
SELECT CAST(CAST(val AS INTEGER) AS VARCHAR) FROM nums;

# ============================================================
# ENUM / UNION constant type-fidelity
# ============================================================
# A folded ENUM constant (or the ENUM that union_tag(...) returns) must keep its
# type on the round-trip — rendered bare it becomes a VARCHAR and the type-sensitive
# result comparison diverges. LPTS emits CAST('<value>' AS ENUM(...)).

statement ok
CREATE TYPE mood AS ENUM ('sad', 'ok', 'happy');

# --- enum literal via a named catalog type ---
query I
SELECT 'happy'::mood;
----
happy

statement ok
SELECT 'happy'::mood;

# --- enum literal via an inline ENUM type ---
query I
SELECT 'hello'::ENUM('world', 'hello');
----
hello

statement ok
SELECT 'hello'::ENUM('world', 'hello');

# --- comparison/greatest over enum values stays enum-typed ---
query I
SELECT greatest('ok'::mood, 'happy'::mood, 'sad'::mood);
----
happy

statement ok
SELECT greatest('ok'::mood, 'happy'::mood, 'sad'::mood);

# --- union_tag returns an ENUM of the member names ---
query I
SELECT union_tag('foo'::UNION(num INTEGER, str VARCHAR));
----
str

statement ok
SELECT union_tag('foo'::UNION(num INTEGER, str VARCHAR));

statement ok
SELECT union_tag(1::INTEGER::UNION(f1 VARCHAR, t DOUBLE, f2 BOOLEAN));

# ============================================================
# Integer boundary + BIT-filter constant type fidelity
# ============================================================
# INT_MIN (-2147483648) is the one INTEGER value whose bare literal re-parses as BIGINT (2147483648
# overflows INT32, then negated), so its type is lost on the round-trip. LPTS casts it explicitly.

query II
SELECT '2147483647.1'::INTEGER AS a, '-2147483648.1'::INTEGER AS b;
----
2147483647	-2147483648

statement ok
SELECT '2147483647.1'::INTEGER AS a, '-2147483648.1'::INTEGER AS b;

# folded via other paths (exponent-string cast, BIT->INT, multiplication overflow) all reach INT_MIN
statement ok
SELECT '-214748364.8e1'::INTEGER;

statement ok
SELECT '10000000000000000000000000000000'::BIT::INT;

statement ok
SELECT -2::INTEGER * 1073741824::INTEGER;

# DuckDB 2.0 parses its native minimum INTEGER literal as INTEGER (not BIGINT), so the native
# constant exporter no longer needs an explicit cast around this folded value.
query I
SELECT sql LIKE '%SELECT  -2147483648 AS scalar_0%' FROM lpts_query('SELECT ''-2147483648.1''::INTEGER');
----
true

# ordinary integers stay bare (no needless cast)
query I
SELECT sql LIKE '% 42%' AND sql NOT LIKE '%CAST(''42''%' FROM lpts_query('SELECT 42 AS x');
----
true

# --- BIT constant in a pushed-down filter keeps its type (b = '111' must not become b = 111) ---
statement ok
CREATE TABLE bits (b BIT);

statement ok
INSERT INTO bits VALUES ('111'::BIT), ('101'::BIT), ('0101'::BIT);

query I
SELECT b::VARCHAR FROM bits WHERE b = '111';
----
111

statement ok
SELECT * FROM bits WHERE b = '111';

# --- typed-NULL table-function argument keeps its type ---
# test_vector_types(NULL::INT[]) selects which vectors to generate by the argument's type; a bare NULL
# would generate different data, so LPTS must render CAST(NULL AS INTEGER[]).

query I
SELECT sql LIKE '%CAST(NULL AS INTEGER[])%'
FROM lpts_query('SELECT c FROM test_vector_types(NULL::INT[]) t(c) WHERE len(c) > 0');
----
true

statement ok
SELECT list_reduce(c, lambda x, y: x + y) FROM test_vector_types(NULL::INT[]) t(c) WHERE len(c) > 0;

# Native VARIANT expressions over columns need no VARIANT value literal.
statement ok
CREATE TABLE variant_source(k INT,v VARCHAR);

statement ok
INSERT INTO variant_source VALUES (1,'one'),(2,'two'),(NULL,NULL);

statement ok
SELECT CAST(k AS VARIANT),variant_typeof(CAST(k AS VARIANT)) FROM variant_source;

statement ok
SELECT variant_typeof(CAST(k AS VARIANT)),SUM(k) FROM variant_source
GROUP BY variant_typeof(CAST(k AS VARIANT));

statement ok
SELECT k::VARIANT,COUNT(*) FROM variant_source GROUP BY k::VARIANT;

statement ok
SELECT struct_pack(value := CAST(k AS VARIANT)),[CAST(k AS VARIANT)] FROM variant_source;

statement ok
CREATE TABLE stored_variants AS SELECT k,CAST(v AS VARIANT) value FROM variant_source;

statement ok
SELECT value,variant_typeof(value) FROM stored_variants;

statement ok
SELECT * FROM stored_variants WHERE variant_typeof(value)='VARCHAR';

statement ok
SELECT value.missing_field FROM stored_variants;

statement ok
SELECT CAST(NULL AS VARIANT);

statement ok
SELECT CASE WHEN k IS NULL THEN NULL::VARIANT ELSE k::VARIANT END FROM variant_source;

# Folded non-NULL VARIANT values still have no faithful inline SQL literal.
statement error
SELECT * FROM lpts_query('SELECT 1::VARIANT');
----
LPTS_UNSUPPORTED_TYPE

# Field extraction from shredded VARIANTs retains storage-dependent dictionaries.
# lpts_check must compare logical values, including VARIANTs nested inside other types.
statement ok
SET variant_minimum_shredding_size=0;

statement ok
CREATE TABLE shredded_variants(j VARIANT);

statement ok
INSERT INTO shredded_variants
SELECT CASE WHEN i%3=0 THEN
  {'kind':'commit','did':'c'||(i%4),'commit':{'collection':'coll'||(i%2),'operation':'create'}}::VARIANT
ELSE {'kind':'identity','did':'d'||(i%5)}::VARIANT END FROM range(4096)t(i);

statement ok
CHECKPOINT;

query TII rowsort
SELECT j.commit.collection AS event,COUNT(*) AS count,COUNT(DISTINCT j.did) AS users
FROM shredded_variants WHERE j.kind='commit' AND j.commit.operation='create'
GROUP BY event;
----
coll0	683	2
coll1	683	2

statement ok
SELECT j.commit.collection, j.did, j.commit.missing FROM shredded_variants WHERE j.kind='commit';

statement ok
SELECT struct_pack(value := j.commit.collection),[j.did,j.commit.missing],
       [j.did,j.commit.missing]::VARIANT[2],map(['value'],[j.commit.collection]),
       union_value(value := j.did)
FROM shredded_variants WHERE j.kind='commit';

# Preserve different payload types, SQL NULLs, object NULLs and nested objects/arrays.
statement ok
CREATE TABLE mixed_variants AS
SELECT CASE i%6 WHEN 0 THEN i::TINYINT::VARIANT WHEN 1 THEN i::BIGINT::VARIANT
  WHEN 2 THEN NULL::VARIANT WHEN 3 THEN {'b':[i,i+1],'a':NULL}::VARIANT
  WHEN 4 THEN (i::DECIMAL(10,2))::VARIANT ELSE ('value'||i)::VARIANT END AS j
FROM range(60)t(i);

statement ok
CHECKPOINT;

statement ok
SELECT j,variant_typeof(j),struct_pack(value := j),[j] FROM mixed_variants;
