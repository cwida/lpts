# name: test/sql/having.test
# description: test lpts with HAVING clauses (GROUP BY + post-aggregate filter)
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE sales (product VARCHAR, region VARCHAR, amount INTEGER);

statement ok
INSERT INTO sales VALUES
  ('A', 'EU', 100), ('A', 'EU', 200), ('A', 'EU', 300),
  ('A', 'EU', 400), ('A', 'EU', 500), ('A', 'EU', 600),
  ('B', 'US', 50),
  ('C', 'EU', 1100),
  ('D', 'US', 600), ('D', 'US', 600);

# --- HAVING count(*) > 5: only group with 6 rows passes ---

query II
SELECT product, count(*) FROM sales GROUP BY product HAVING count(*) > 5;
----
A	6

statement ok
SELECT product, count(*) FROM sales GROUP BY product HAVING count(*) > 5;

# --- HAVING count(*) > 1: multiple groups pass ---

query II rowsort
SELECT product, count(*) FROM sales GROUP BY product HAVING count(*) > 1;
----
A	6
D	2

statement ok
SELECT product, count(*) FROM sales GROUP BY product HAVING count(*) > 1;

# --- HAVING sum(amount) > threshold ---

query II rowsort
SELECT region, sum(amount) FROM sales GROUP BY region HAVING sum(amount) > 200;
----
EU	3200
US	1250

statement ok
SELECT region, sum(amount) FROM sales GROUP BY region HAVING sum(amount) > 200;

# --- HAVING with equality: exactly equal to a value ---

query II
SELECT product, count(*) FROM sales GROUP BY product HAVING count(*) = 2;
----
D	2

statement ok
SELECT product, count(*) FROM sales GROUP BY product HAVING count(*) = 2;

# --- HAVING that matches no group: empty result ---

query II
SELECT product, count(*) FROM sales GROUP BY product HAVING count(*) > 100;
----

statement ok
SELECT product, count(*) FROM sales GROUP BY product HAVING count(*) > 100;

# --- WHERE before aggregation, HAVING after: independent filtering stages ---

query II rowsort
SELECT product, count(*) FROM sales WHERE amount > 100 GROUP BY product HAVING count(*) > 2;
----
A	5

statement ok
SELECT product, count(*) FROM sales WHERE amount > 100 GROUP BY product HAVING count(*) > 2;

# --- WHERE on string column + HAVING on sum ---

query II
SELECT region, sum(amount) FROM sales WHERE region = 'EU' GROUP BY region HAVING sum(amount) > 500;
----
EU	3200

statement ok
SELECT region, sum(amount) FROM sales WHERE region = 'EU' GROUP BY region HAVING sum(amount) > 500;

# --- WHERE eliminates all rows before grouping: no groups reach HAVING ---

query II
SELECT product, count(*) FROM sales WHERE amount > 99999 GROUP BY product HAVING count(*) > 0;
----

statement ok
SELECT product, count(*) FROM sales WHERE amount > 99999 GROUP BY product HAVING count(*) > 0;

# --- HAVING min/max: filter groups by their minimum value ---

statement ok
SELECT product, min(amount) FROM sales GROUP BY product HAVING min(amount) > 100;

statement ok
SELECT product, max(amount) FROM sales GROUP BY product HAVING max(amount) < 1000;

# --- HAVING avg: filter groups by average ---

statement ok
SELECT product, avg(amount) FROM sales GROUP BY product HAVING avg(amount) > 100;

# --- Multi-column GROUP BY with HAVING ---

query III rowsort
SELECT product, region, count(*) FROM sales GROUP BY product, region HAVING count(*) >= 2;
----
A	EU	6
D	US	2

statement ok
SELECT product, region, count(*) FROM sales GROUP BY product, region HAVING count(*) >= 2;

# --- HAVING on empty table: no groups, no output ---

statement ok
CREATE TABLE empty_sales (product VARCHAR, amount INTEGER);

query II
SELECT product, count(*) FROM empty_sales GROUP BY product HAVING count(*) > 0;
----

statement ok
SELECT product, count(*) FROM empty_sales GROUP BY product HAVING count(*) > 0;

# --- HAVING without GROUP BY: an implicit single-group (ungrouped) aggregate collapses the input to
# one row purely by being an aggregate, even when no aggregate value is projected. LPTS must not fuse a
# constant projection over it (which would drop the aggregation and emit one row per input row). ---

query I
SELECT 1 AS one FROM (VALUES (1,2),(3,2)) t(a, b) HAVING 1 < 2;
----
1

query I
SELECT 1 AS one FROM (VALUES (1,2),(3,2)) t(a, b) HAVING false;
----

# Ungrouped aggregate whose value IS used still fuses/round-trips correctly.
query I
SELECT count(*) + 1 AS c FROM (VALUES (1,2),(3,2)) t(a, b) HAVING count(*) > 1;
----
3
