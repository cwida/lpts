# name: test/sql/select.test
# description: test lpts with basic SELECT queries
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE users (id INTEGER, name VARCHAR, age INTEGER);

statement ok
INSERT INTO users VALUES (1, 'Alice', 30), (2, 'Bob', 25), (3, 'Carol', 35), (4, 'Dave', 25);

# --- SELECT *: all rows and columns round-trip correctly ---

query III rowsort
SELECT * FROM users;
----
1	Alice	30
2	Bob	25
3	Carol	35
4	Dave	25

statement ok
SELECT * FROM users;

# --- SELECT specific columns: projection reduces column set ---

query II rowsort
SELECT id, name FROM users;
----
1	Alice
2	Bob
3	Carol
4	Dave

statement ok
SELECT id, name FROM users;

# --- SELECT single column ---

query I rowsort
SELECT name FROM users;
----
Alice
Bob
Carol
Dave

statement ok
SELECT name FROM users;

# --- SELECT with equality filter: exact match ---

query III
SELECT * FROM users WHERE id = 1;
----
1	Alice	30

statement ok
SELECT * FROM users WHERE id = 1;

# --- SELECT with range filter (>): filters rows correctly ---

query III rowsort
SELECT * FROM users WHERE age > 25;
----
1	Alice	30
3	Carol	35

statement ok
SELECT * FROM users WHERE age > 25;

# --- SELECT with >= filter: boundary value included ---

query III rowsort
SELECT * FROM users WHERE age >= 30;
----
1	Alice	30
3	Carol	35

statement ok
SELECT * FROM users WHERE age >= 30;

# --- SELECT with < filter ---

query III rowsort
SELECT * FROM users WHERE age < 30;
----
2	Bob	25
4	Dave	25

statement ok
SELECT * FROM users WHERE age < 30;

# --- SELECT with string equality filter ---

query III
SELECT * FROM users WHERE name = 'Alice';
----
1	Alice	30

statement ok
SELECT * FROM users WHERE name = 'Alice';

# --- SELECT with AND conjunction: both conditions must hold ---

query III
SELECT * FROM users WHERE age > 20 AND name = 'Bob';
----
2	Bob	25

statement ok
SELECT * FROM users WHERE age > 20 AND name = 'Bob';

# --- SELECT with OR conjunction: either condition sufficient ---

query III rowsort
SELECT * FROM users WHERE name = 'Alice' OR name = 'Carol';
----
1	Alice	30
3	Carol	35

statement ok
SELECT * FROM users WHERE name = 'Alice' OR name = 'Carol';

statement ok
SELECT id, name FROM users WHERE id = 1 OR id = 2;

statement ok
SELECT * FROM users WHERE id IN (SELECT id FROM users WHERE id < 3);

# --- SELECT with filter that matches no rows: empty result ---

query III
SELECT * FROM users WHERE age > 100;
----

statement ok
SELECT * FROM users WHERE age > 100;

# --- SELECT from empty table: zero rows ---

statement ok
CREATE TABLE empty_tbl (x INTEGER, y VARCHAR);

query II
SELECT * FROM empty_tbl;
----

statement ok
SELECT * FROM empty_tbl;

# --- SELECT constant expression in projection ---

statement ok
SELECT 1 + age FROM users;

# --- SELECT with NULL values: NULLs propagate through the plan ---

statement ok
CREATE TABLE nullable (id INTEGER, val INTEGER);

statement ok
INSERT INTO nullable VALUES (1, 10), (2, NULL), (3, 30);

query II rowsort
SELECT id, val FROM nullable;
----
1	10
2	NULL
3	30

statement ok
SELECT id, val FROM nullable;

# --- SELECT with IS NULL filter ---

query II
SELECT id, val FROM nullable WHERE val IS NULL;
----
2	NULL

statement ok
SELECT id, val FROM nullable WHERE val IS NULL;

# --- SELECT with IS NOT NULL filter ---

query II rowsort
SELECT id, val FROM nullable WHERE val IS NOT NULL;
----
1	10
3	30

statement ok
SELECT id, val FROM nullable WHERE val IS NOT NULL;

# Arithmetic expressions — rendered as infix (a + b), not function calls +(a, b)
statement ok
SELECT id + age FROM users;

statement ok
SELECT id * age + 1 FROM users;

statement ok
SELECT age / NULLIF(id, 0) FROM users;

statement ok
SELECT age - id, age % 3 FROM users;
