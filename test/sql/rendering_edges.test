# name: test/sql/rendering_edges.test
# description: regression tests for fragile SQL rendering and binding edges
# group: [sql]

require lpts

statement ok
CREATE TABLE rendering_edges (grp VARCHAR, item VARCHAR, amount INTEGER, amount2 INTEGER);

statement ok
INSERT INTO rendering_edges VALUES
	('a', 'x', 10, 1),
	('a', 'y', 20, 2),
	('a', 'z', 30, 3),
	('b', 'x', 5, 4),
	('b', 'y', 15, 5);

# string_agg bind data supplies the separator; ORDER BY keeps the aggregate deterministic.
query I
PRAGMA lpts_check('SELECT grp, string_agg(item, '':'' ORDER BY item) FROM rendering_edges GROUP BY grp ORDER BY grp');
----
true

# quantile_cont bind data supplies the quantile argument.
query I
PRAGMA lpts_check('SELECT grp, quantile_cont(amount, 0.5) FROM rendering_edges GROUP BY grp ORDER BY grp');
----
true

# Multiple quantiles render as a list argument.
query I
PRAGMA lpts_check('SELECT grp, quantile_cont(amount, [0.25, 0.75]) FROM rendering_edges GROUP BY grp ORDER BY grp');
----
true

# approx_quantile stores the quantile argument in aggregate bind data too.
query I
PRAGMA lpts_check('SELECT grp, approx_quantile(amount, 0.5) FROM rendering_edges GROUP BY grp ORDER BY grp');
----
true

# Two-argument aggregates must serialize both arguments through the aggregate child scope.
query I
PRAGMA lpts_check('SELECT grp, corr(amount, amount2) FROM rendering_edges GROUP BY grp ORDER BY grp');
----
true

# GROUPING() over grouping sets exercises aggregate output remapping.
query I
PRAGMA lpts_check('SELECT grp, item, GROUPING(grp), GROUPING(item), sum(amount) FROM rendering_edges GROUP BY ROLLUP (grp, item) ORDER BY grp NULLS LAST, item NULLS LAST');
----
true

statement ok
CREATE TABLE rendering_customers (c_w_id INTEGER, c_id INTEGER, c_balance BIGINT);

statement ok
CREATE TABLE rendering_orders (o_w_id INTEGER, o_c_id INTEGER);

statement ok
INSERT INTO rendering_customers VALUES (1, 1, 10), (1, 2, 20), (2, 1, 30);

statement ok
INSERT INTO rendering_orders VALUES (1, 1), (1, 1), (2, 1);

# Regression shape from OpenIVM q1888: nested CTEs, LEFT JOIN, AVG decomposition candidates,
# and a two-argument aggregate above the join.
query I
PRAGMA lpts_check('WITH cust AS (SELECT c_w_id, c_id, c_balance FROM rendering_customers), orders AS (SELECT o_w_id, o_c_id, COUNT(*) AS n FROM rendering_orders GROUP BY o_w_id, o_c_id), joined AS (SELECT c.c_w_id, c.c_id, c.c_balance, COALESCE(o.n, 0) AS orders FROM cust c LEFT JOIN orders o ON c.c_w_id = o.o_w_id AND c.c_id = o.o_c_id) SELECT c_w_id, AVG(c_balance) AS avg_bal, AVG(orders) AS avg_ord, CORR(c_balance, orders) AS corr FROM joined GROUP BY c_w_id');
----
true
