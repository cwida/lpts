# name: test/sql/join.test
# description: test lpts with JOIN queries
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE users (id INTEGER, name VARCHAR);

statement ok
CREATE TABLE orders (id INTEGER, user_id INTEGER, amount DECIMAL);

statement ok
INSERT INTO users VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Carol');

statement ok
INSERT INTO orders VALUES (1, 1, 100.0), (2, 1, 200.0), (3, 2, 150.0);

# --- INNER JOIN: only rows with matches on both sides ---

query II rowsort
SELECT u.name, o.amount FROM users u JOIN orders o ON u.id = o.user_id;
----
Alice	100.0
Alice	200.0
Bob	150.0

statement ok
SELECT u.name, o.amount FROM users u JOIN orders o ON u.id = o.user_id;

# --- INNER JOIN with filter: WHERE applied after join ---

query II rowsort
SELECT u.name, o.amount FROM users u JOIN orders o ON u.id = o.user_id WHERE o.amount > 100;
----
Alice	200.0
Bob	150.0

statement ok
SELECT u.name, o.amount FROM users u JOIN orders o ON u.id = o.user_id WHERE o.amount > 100;

# --- LEFT JOIN: all left rows kept; Carol has no orders so amount is NULL ---

query II rowsort
SELECT u.name, o.amount FROM users u LEFT JOIN orders o ON u.id = o.user_id;
----
Alice	100.0
Alice	200.0
Bob	150.0
Carol	NULL

statement ok
SELECT u.name, o.amount FROM users u LEFT JOIN orders o ON u.id = o.user_id;

# --- LEFT JOIN with IS NULL: find users with no orders ---

query I
SELECT u.name FROM users u LEFT JOIN orders o ON u.id = o.user_id WHERE o.id IS NULL;
----
Carol

statement ok
SELECT u.name FROM users u LEFT JOIN orders o ON u.id = o.user_id WHERE o.id IS NULL;

# --- RIGHT JOIN: DuckDB rewrites internally; all order rows kept ---

statement ok
SELECT u.name, o.amount FROM users u RIGHT JOIN orders o ON u.id = o.user_id;

# --- FULL OUTER JOIN: all rows from both sides ---

statement ok
SELECT u.name, o.amount FROM users u FULL OUTER JOIN orders o ON u.id = o.user_id;

# --- ASOF JOIN: nearest prior row on the RHS ---

statement ok
CREATE TABLE trades(symbol VARCHAR, ts TIMESTAMP, qty INTEGER);

statement ok
CREATE TABLE prices(symbol VARCHAR, ts TIMESTAMP, price INTEGER);

statement ok
INSERT INTO trades VALUES
	('A', '2026-01-01 10:05:00', 10),
	('A', '2026-01-01 10:20:00', 20),
	('B', '2026-01-01 10:10:00', 30);

statement ok
INSERT INTO prices VALUES
	('A', '2026-01-01 10:00:00', 100),
	('A', '2026-01-01 10:15:00', 110),
	('B', '2026-01-01 10:00:00', 200);

statement ok
SELECT t.symbol, t.ts, p.price FROM trades t ASOF JOIN prices p ON t.symbol = p.symbol AND t.ts >= p.ts ORDER BY t.symbol, t.ts;

statement ok
SELECT t.symbol, t.ts, p.price FROM trades t ASOF LEFT JOIN prices p ON t.symbol = p.symbol AND t.ts >= p.ts ORDER BY t.symbol, t.ts;

statement ok
SELECT t.symbol FROM trades t ASOF JOIN prices p ON t.symbol = p.symbol AND t.ts >= p.ts ORDER BY t.symbol, t.ts;

# --- POSITIONAL JOIN: row-wise pairing ---

statement ok
CREATE TABLE pos_left(a INTEGER);

statement ok
CREATE TABLE pos_right(b VARCHAR);

statement ok
INSERT INTO pos_left VALUES (1), (2), (3);

statement ok
INSERT INTO pos_right VALUES ('x'), ('y');

statement ok
SELECT a, b FROM pos_left POSITIONAL JOIN pos_right ORDER BY a NULLS LAST, b NULLS LAST;

# --- JOIN with computed expression in projection ---

statement ok
CREATE TABLE staff (id INTEGER, dept VARCHAR, salary INTEGER);

statement ok
CREATE TABLE bonus (dept VARCHAR, amount INTEGER);

statement ok
INSERT INTO staff VALUES (1, 'eng', 50000), (2, 'sales', 60000), (3, 'eng', 55000);

statement ok
INSERT INTO bonus VALUES ('eng', 5000), ('sales', 6000);

query II rowsort
SELECT s.id, s.salary + b.amount FROM staff s JOIN bonus b ON s.dept = b.dept;
----
1	55000
2	66000
3	60000

statement ok
SELECT s.id, s.salary + b.amount FROM staff s JOIN bonus b ON s.dept = b.dept;

# --- JOIN on string column ---

query II rowsort
SELECT s.dept, s.salary FROM staff s JOIN bonus b ON s.dept = b.dept;
----
eng	50000
eng	55000
sales	60000

statement ok
SELECT s.dept, s.salary FROM staff s JOIN bonus b ON s.dept = b.dept;

# --- JOIN with GROUP BY on joined result ---

query II rowsort
SELECT s.dept, sum(s.salary) FROM staff s JOIN bonus b ON s.dept = b.dept GROUP BY s.dept;
----
eng	105000
sales	60000

statement ok
SELECT s.dept, sum(s.salary) FROM staff s JOIN bonus b ON s.dept = b.dept GROUP BY s.dept;

# --- Self-join: join a table with itself ---

statement ok
SELECT a.name, b.name FROM users a JOIN users b ON a.id != b.id AND a.id < b.id;

# Duplicate column names across tables (projection deduplication)
statement ok
SELECT u.id, o.id FROM users u INNER JOIN orders o ON u.id = o.user_id;

statement ok
SELECT u.id, o.id, s.id FROM users u, orders o, staff s;

# Self-join (same table twice — same column names)
statement ok
SELECT a.id, b.id, a.name FROM users a INNER JOIN users b ON a.id = b.id;

# --- CROSS JOIN: Cartesian product ---
statement ok
SELECT u.name, o.amount FROM users u CROSS JOIN orders o;

# --- Implicit join syntax (comma): equivalent to CROSS JOIN ---

statement ok
SELECT u.name, s.salary FROM users u, staff s;

# --- Three-way JOIN ---

statement ok
SELECT u.name, o.amount, s.salary FROM users u JOIN orders o ON u.id = o.user_id JOIN staff s ON u.id = s.id;

# --- UNION ALL of two JOIN results ---

query II rowsort
SELECT u.name, o.amount FROM users u JOIN orders o ON u.id = o.user_id UNION ALL SELECT u.name, o.amount FROM users u JOIN orders o ON u.id = o.user_id;
----
Alice	100.0
Alice	100.0
Alice	200.0
Alice	200.0
Bob	150.0
Bob	150.0

statement ok
SELECT u.name, o.amount FROM users u JOIN orders o ON u.id = o.user_id UNION ALL SELECT u.name, o.amount FROM users u JOIN orders o ON u.id = o.user_id;

# ============================================================
# MARK JOIN: IN subquery
# ============================================================

statement ok
CREATE TABLE t1 (id INTEGER, val INTEGER);

statement ok
CREATE TABLE t2 (id INTEGER);

statement ok
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);

statement ok
INSERT INTO t2 VALUES (1), (3);

# --- IN subquery: rows in t1 whose id appears in t2 ---

query II rowsort
SELECT id, val FROM t1 WHERE id IN (SELECT id FROM t2);
----
1	10
3	30

statement ok
SELECT id, val FROM t1 WHERE id IN (SELECT id FROM t2);

# --- NOT IN subquery: rows in t1 whose id does not appear in t2 ---

query II
SELECT id, val FROM t1 WHERE id NOT IN (SELECT id FROM t2);
----
2	20

statement ok
SELECT id, val FROM t1 WHERE id NOT IN (SELECT id FROM t2);

# --- IN subquery with aggregate ---

statement ok
SELECT id FROM t1 WHERE id IN (SELECT MAX(id) FROM t2);

# ============================================================
# MARK JOIN: duplicate RHS values must not produce extra rows
# ============================================================
# LPTS converts MARK join to LEFT JOIN + WHERE (rhs IS NOT NULL).
# The right side is wrapped in SELECT DISTINCT to prevent left-row
# multiplication when the RHS has repeated values — IN subquery
# semantics treat the RHS as a set so duplicates must be ignored.

statement ok
CREATE TABLE t2_dups (id INTEGER);

statement ok
INSERT INTO t2_dups VALUES (1), (1), (3);

# Without SELECT DISTINCT on the RHS, id=1 would appear twice in the output.
query II rowsort
SELECT id, val FROM t1 WHERE id IN (SELECT id FROM t2_dups);
----
1	10
3	30

statement ok
SELECT id, val FROM t1 WHERE id IN (SELECT id FROM t2_dups);

# ============================================================
# 3-valued MARK join: correlated ANY/ALL with NULLs
# ============================================================
# IN/ANY/ALL marks are 3-valued (NULL when the membership comparison
# is indeterminate). A decorrelated mark join's conditions split into
# null-safe correlation keys (IS NOT DISTINCT FROM) and a single
# NULL-propagating membership comparison; the comparison's operands
# drive the NULL (indeterminate) case. The membership comparison can
# live in a LOGICAL_COMPARISON_JOIN or in the DELIM/DEPENDENT join path
# (e.g. when the subquery returns a projected expression).

statement ok
CREATE TABLE integers (i INTEGER);

statement ok
INSERT INTO integers VALUES (1), (2), (3), (NULL);

# Correlated ALL over a projected expression (DELIM mark join; the
# comparison CAST(i AS DOUBLE) <= scalar_0 sits among the join
# conditions). i=NULL yields NULL (indeterminate), excluded by ALL.
query I
SELECT i FROM integers i1 WHERE i > ALL(SELECT (i + i1.i - 1) / 2 FROM integers WHERE i IS NOT NULL) ORDER BY i;
----
3

statement ok
SELECT i FROM integers i1 WHERE i > ALL(SELECT (i + i1.i - 1) / 2 FROM integers WHERE i IS NOT NULL) ORDER BY i;

# Uncorrelated ALL with a NULL in the subquery: every comparison is
# indeterminate, so the ALL is never TRUE.
query I
SELECT i FROM integers WHERE i < ALL(SELECT i FROM integers) ORDER BY i;
----

statement ok
SELECT i FROM integers WHERE i < ALL(SELECT i FROM integers) ORDER BY i;

# Uncorrelated ANY with a NULL in the subquery.
query I
SELECT i FROM integers WHERE i = ANY(SELECT i FROM integers) ORDER BY i;
----
1
2
3

statement ok
SELECT i FROM integers WHERE i = ANY(SELECT i FROM integers) ORDER BY i;

# Correlated ANY: each outer row checks membership against its own group.
query I
SELECT i FROM integers i1 WHERE i >= ANY(SELECT i FROM integers WHERE i <= i1.i) ORDER BY i;
----
1
2
3

statement ok
SELECT i FROM integers i1 WHERE i >= ANY(SELECT i FROM integers WHERE i <= i1.i) ORDER BY i;

# ============================================================
# SINGLE join (scalar subquery) must not multiply the outer row
# ============================================================
# A scalar subquery is a SINGLE join: at most one row per outer row. When the (decorrelated) subquery
# carries duplicate rows per correlation key — e.g. a non-aggregated subquery over a multi-row table —
# LPTS must deduplicate the right side, else the outer row is multiplied. Allow the multi-row form to
# return one (arbitrary but here constant) row rather than raising.

statement ok
SET scalar_subquery_error_on_multiple_rows = false;

# The inner value (42 + i1.i) is constant w.r.t. the subquery's own rows, so the single value is
# well-defined; the rewrite must still yield exactly one row per outer row.
query II
SELECT i, (SELECT 42 + i1.i FROM integers) AS j FROM integers i1 ORDER BY i;
----
1	43
2	44
3	45
NULL	NULL

statement ok
SELECT i, (SELECT 42 + i1.i FROM integers) AS j FROM integers i1 ORDER BY i;

# scalar subquery through a CTE
statement ok
SELECT i, (WITH t AS (SELECT 42 + i1.i AS j FROM integers) SELECT j FROM t) AS j FROM integers i1 ORDER BY i;

statement ok
RESET scalar_subquery_error_on_multiple_rows;

# ============================================================
# LOGICAL_EMPTY_RESULT: optimizer collapses to empty
# ============================================================

# --- LIMIT 0 on a join ---

statement ok
SELECT t1.id, t2.id FROM t1 JOIN t2 ON t1.id = t2.id LIMIT 0;

query II
SELECT t1.id, t2.id FROM t1 JOIN t2 ON t1.id = t2.id LIMIT 0;
----

# --- Unsatisfiable WHERE clause ---

statement ok
SELECT id, val FROM t1 WHERE 1 = 2;

query II
SELECT id, val FROM t1 WHERE 1 = 2;
----

# --- Empty result on one side of a JOIN ---

statement ok
SELECT t1.id FROM t1 JOIN (SELECT id FROM t2 WHERE 1 = 2) sub ON t1.id = sub.id;

query I
SELECT t1.id FROM t1 JOIN (SELECT id FROM t2 WHERE 1 = 2) sub ON t1.id = sub.id;
----

# --- Empty result with multiple column types ---

statement ok
CREATE TABLE typed (a INTEGER, b VARCHAR, c DOUBLE, d BOOLEAN);

statement ok
INSERT INTO typed VALUES (1, 'hello', 3.14, true);

statement ok
SELECT a, b, c, d FROM typed LIMIT 0;

query ITRI
SELECT a, b, c, d FROM typed LIMIT 0;
----

# --- the right (inner) side of a join is materialized in a CTE marked with a suffix ---
query I
SELECT sql LIKE '%_materialized_for_join (%' AND sql LIKE '%JOIN%_materialized_for_join %'
FROM lpts_query('SELECT users.name, orders.amount FROM users JOIN orders ON users.id = orders.user_id');
----
true

statement ok
SELECT users.name, orders.amount FROM users JOIN orders ON users.id = orders.user_id;

statement ok
SELECT users.name, orders.amount FROM users JOIN orders ON users.id = orders.user_id;

statement ok
SELECT users.name FROM users JOIN orders ON users.id = orders.user_id ORDER BY orders.amount, users.name;
