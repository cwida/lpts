# name: test/sql/data_dependent_optimizers.test
# description: test LPTS data-dependent optimizer setting
# group: [sql]

require lpts

statement ok
CREATE TABLE dd_t(a INTEGER);

statement ok
INSERT INTO dd_t VALUES (1), (2);

# Conservative mode is the default: current column statistics must not turn
# a future-sensitive predicate into a fixed WHERE false plan.
query I
SELECT sql NOT LIKE '%WHERE false%' FROM lpts_query('SELECT * FROM dd_t WHERE a > 10');
----
true

query I
PRAGMA lpts_check('SELECT * FROM dd_t WHERE a > 10');
----
true

# Data-independent contradictions can still become empty results in
# conservative mode. Only statistics-derived emptiness is disabled.
query I
SELECT sql LIKE '%WHERE false%' FROM lpts_query('SELECT * FROM dd_t WHERE 1 = 0');
----
true

query I
PRAGMA lpts_check('SELECT * FROM dd_t WHERE 1 = 0');
----
true

statement ok
INSERT INTO dd_t VALUES (11);

query I
PRAGMA lpts_check('SELECT * FROM dd_t WHERE a > 10');
----
true

query I
PRAGMA lpts_exec('SELECT * FROM dd_t WHERE a > 10');
----
11

statement ok
CREATE TABLE dd_small(a INTEGER);

statement ok
INSERT INTO dd_small VALUES (1), (2);

# Opting in restores DuckDB's data-dependent planning behavior for LPTS.
statement ok
SET lpts_enable_data_dependent_optimizers = true;

query I
SELECT sql LIKE '%WHERE false%' FROM lpts_query('SELECT * FROM dd_small WHERE a > 10');
----
true

# Opting in does not override optimizers explicitly disabled by the user.
statement ok
SET disabled_optimizers = 'STATISTICS_PROPAGATION';

query I
SELECT sql NOT LIKE '%WHERE false%' FROM lpts_query('SELECT * FROM dd_small WHERE a > 10');
----
true

query I
SELECT current_setting('disabled_optimizers') = 'statistics_propagation';
----
true

statement ok
SET disabled_optimizers = '';

statement ok
SET lpts_enable_data_dependent_optimizers = false;

# LPTS must not leak its scoped optimizer changes into the user's session.
statement ok
SET disabled_optimizers = 'REORDER_FILTER';

query I
SELECT count(*) FROM lpts_query('SELECT * FROM dd_t WHERE a > 10');
----
1

query I
SELECT current_setting('disabled_optimizers') = 'reorder_filter';
----
true

statement error
SELECT count(*) FROM lpts_query('SELECT * FROM dd_missing_table');
----
Catalog Error

query I
SELECT current_setting('disabled_optimizers') = 'reorder_filter';
----
true

statement ok
SET disabled_optimizers = '';

statement ok
CREATE TABLE dd_a(k INTEGER, av INTEGER);

statement ok
CREATE TABLE dd_b(k INTEGER, bv INTEGER);

statement ok
CREATE TABLE dd_c(k INTEGER, cv INTEGER);

statement ok
INSERT INTO dd_a SELECT i, i FROM range(1, 3) tbl(i);

statement ok
INSERT INTO dd_b SELECT i, i FROM range(1, 1001) tbl(i);

statement ok
INSERT INTO dd_c SELECT i, i FROM range(1, 1001) tbl(i);

statement ok
CREATE TABLE dd_hashes(name VARCHAR, hash VARCHAR);

statement ok
INSERT INTO dd_hashes
SELECT 'small_a', md5(sql)
FROM lpts_query('SELECT dd_a.k, av, bv, cv FROM dd_a, dd_b, dd_c WHERE dd_a.k=dd_b.k AND dd_b.k=dd_c.k');

statement ok
DELETE FROM dd_a;

statement ok
DELETE FROM dd_b;

statement ok
DELETE FROM dd_c;

statement ok
INSERT INTO dd_a SELECT i, i FROM range(1, 1001) tbl(i);

statement ok
INSERT INTO dd_b SELECT i, i FROM range(1, 1001) tbl(i);

statement ok
INSERT INTO dd_c SELECT i, i FROM range(1, 3) tbl(i);

statement ok
INSERT INTO dd_hashes
SELECT 'small_c', md5(sql)
FROM lpts_query('SELECT dd_a.k, av, bv, cv FROM dd_a, dd_b, dd_c WHERE dd_a.k=dd_b.k AND dd_b.k=dd_c.k');

query I
SELECT count(DISTINCT hash) FROM dd_hashes;
----
1

# Conservative mode also keeps ORDER BY + LIMIT as ordinary SQL instead of
# allowing cardinality-dependent TopN plan selection.
query I
SELECT sql NOT LIKE '%topn_%' FROM lpts_query('SELECT * FROM dd_a ORDER BY k LIMIT 10');
----
true

statement ok
SET lpts_enable_data_dependent_optimizers = true;

query I
SELECT sql LIKE '%topn_%' FROM lpts_query('SELECT * FROM dd_a ORDER BY k LIMIT 10');
----
true

statement ok
SET lpts_enable_data_dependent_optimizers = false;

query I
PRAGMA lpts_check('SELECT * FROM dd_a ORDER BY k LIMIT 10');
----
true
