# name: test/sql/cte.test
# description: test lpts with CHUNK_GET, CTE_REF, MATERIALIZED_CTE, CTE_INLINING, NOT MATERIALIZED, nested CTEs, and WITH RECURSIVE
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE t (id INTEGER, val INTEGER, label VARCHAR);

statement ok
INSERT INTO t VALUES (1, 10, 'a'), (2, 20, 'b'), (3, 30, 'c'), (4, 40, 'd'), (5, 50, 'e');

# ============================================================
# CHUNK_GET: IN with 5 literal values → MARK JOIN via VALUES scan
# ============================================================

query II rowsort
SELECT id, val FROM t WHERE val IN (10, 20, 30, 40, 50);
----
1	10
2	20
3	30
4	40
5	50

statement ok
SELECT id, val FROM t WHERE val IN (10, 20, 30, 40, 50);

# --- partial match ---

query II rowsort
SELECT id, val FROM t WHERE val IN (10, 30, 50);
----
1	10
3	30
5	50

statement ok
SELECT id, val FROM t WHERE val IN (10, 30, 50);

# --- NOT IN: produces an ANTI join; no rows match when all values are listed ---

query II
SELECT id, val FROM t WHERE val NOT IN (10, 20, 30, 40, 50);
----

statement ok
SELECT id, val FROM t WHERE val NOT IN (10, 20, 30, 40, 50);

# ============================================================
# MATERIALIZED_CTE + CTE_REF x2: WITH clause used twice
# DuckDB materializes the CTE body and scans it via two CTE_REF nodes.
# ============================================================

# CTE appears in both the outer SELECT and a correlated subquery
query II
WITH high AS (SELECT id, val FROM t WHERE val >= 30) SELECT h1.id, h1.val FROM high h1 WHERE h1.val = (SELECT max(val) FROM high);
----
5	50

statement ok
WITH high AS (SELECT id, val FROM t WHERE val >= 30) SELECT h1.id, h1.val FROM high h1 WHERE h1.val = (SELECT max(val) FROM high);

# CTE self-joined
query I rowsort
WITH numbered AS (SELECT id, val FROM t) SELECT a.id FROM numbered a JOIN numbered b ON a.id = b.id WHERE a.val > 20;
----
3
4
5

statement ok
WITH numbered AS (SELECT id, val FROM t) SELECT a.id FROM numbered a JOIN numbered b ON a.id = b.id WHERE a.val > 20;

# Chained CTEs (base → derived): each CTE used once, no materialization
query II
WITH base AS (SELECT id, val FROM t WHERE val > 10), doubled AS (SELECT id, val * 2 AS val FROM base) SELECT id, val FROM doubled ORDER BY id;
----
2	40
3	60
4	80
5	100

statement ok
WITH base AS (SELECT id, val FROM t WHERE val > 10), doubled AS (SELECT id, val * 2 AS val FROM base) SELECT id, val FROM doubled ORDER BY id;

# CTE with aggregation used twice
statement ok
WITH agg AS (SELECT label, count(*) AS cnt FROM t GROUP BY label) SELECT a1.label FROM agg a1 JOIN agg a2 ON a1.label = a2.label ORDER BY a1.label;

# ============================================================
# CTE_INLINING: single-reference CTE is inlined by the optimizer
# DuckDB inlines the CTE body directly since it is referenced only once.
# ============================================================

query II
WITH single AS (SELECT id, val FROM t WHERE val > 20) SELECT id, val FROM single ORDER BY id;
----
3	30
4	40
5	50

statement ok
WITH single AS (SELECT id, val FROM t WHERE val > 20) SELECT id, val FROM single ORDER BY id;

# ============================================================
# WITH NOT MATERIALIZED: explicitly prevents materialization, always inlined
# ============================================================

query II
WITH nm AS NOT MATERIALIZED (SELECT id, val FROM t WHERE val < 30) SELECT id, val FROM nm ORDER BY id;
----
1	10
2	20

statement ok
WITH nm AS NOT MATERIALIZED (SELECT id, val FROM t WHERE val < 30) SELECT id, val FROM nm ORDER BY id;

# ============================================================
# WITH MATERIALIZED: explicitly forces materialization
# DuckDB keeps the CTE as a LogicalMaterializedCTE + LogicalCTERef pair.
# ============================================================

query II
WITH m AS MATERIALIZED (SELECT id, val FROM t WHERE val <= 20) SELECT id, val FROM m ORDER BY id;
----
1	10
2	20

statement ok
WITH m AS MATERIALIZED (SELECT id, val FROM t WHERE val <= 20) SELECT id, val FROM m ORDER BY id;

# MATERIALIZED CTE referenced twice (the typical reason to force materialization)
statement ok
WITH m AS MATERIALIZED (SELECT id, val FROM t) SELECT m1.id, m2.val FROM m m1 JOIN m m2 ON m1.id = m2.id WHERE m1.val > 10 ORDER BY m1.id;

# ============================================================
# Nested CTEs: a CTE that itself references another CTE
# ============================================================

query II
WITH a AS (SELECT id, val FROM t WHERE val > 10), b AS (SELECT id, val * 3 AS val FROM a WHERE id < 5) SELECT id, val FROM b ORDER BY id;
----
2	60
3	90
4	120

statement ok
WITH a AS (SELECT id, val FROM t WHERE val > 10), b AS (SELECT id, val * 3 AS val FROM a WHERE id < 5) SELECT id, val FROM b ORDER BY id;

# ============================================================
# WITH RECURSIVE
# ============================================================

# Simple counter: 1 to 5
statement ok
WITH RECURSIVE cnt(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM cnt WHERE n<5) SELECT n FROM cnt;

# Counter with outer filter
statement ok
WITH RECURSIVE cnt(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM cnt WHERE n<10) SELECT n FROM cnt WHERE n % 2 = 0;

# Fibonacci sequence
statement ok
WITH RECURSIVE fib(a,b) AS (SELECT 0,1 UNION ALL SELECT b, a+b FROM fib WHERE a<100) SELECT a FROM fib;

# Tree traversal with JOIN
statement ok
CREATE TABLE nodes (id INT, parent INT);

statement ok
INSERT INTO nodes VALUES (1,NULL),(2,1),(3,1),(4,2);

statement ok
WITH RECURSIVE tree(id,depth) AS (SELECT id,0 FROM nodes WHERE parent IS NULL UNION ALL SELECT n.id, t.depth+1 FROM nodes n JOIN tree t ON n.parent=t.id) SELECT id,depth FROM tree ORDER BY id;

# Recursive step with ORDER BY + LIMIT, which DuckDB plans as TopN.
statement ok
WITH RECURSIVE cnt(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM (SELECT n FROM cnt ORDER BY n DESC LIMIT 1) s WHERE n < 5) SELECT n FROM cnt ORDER BY n;

# Recursive step with SEMI JOIN.
statement ok
CREATE TABLE recursive_allowed (n INT);

statement ok
INSERT INTO recursive_allowed VALUES (1), (2), (3);

statement ok
WITH RECURSIVE cnt(n) AS (SELECT 1 UNION ALL SELECT cnt.n + 1 FROM cnt SEMI JOIN recursive_allowed a ON cnt.n = a.n WHERE cnt.n < 5) SELECT n FROM cnt ORDER BY n;

# Recursive step with a correlated scalar subquery, which can introduce DelimJoin/SINGLE nodes.
statement ok
WITH RECURSIVE cnt(n) AS (SELECT 1 UNION ALL SELECT cnt.n + 1 FROM cnt JOIN recursive_allowed a ON a.n = (SELECT max(r.n) FROM recursive_allowed r WHERE r.n = cnt.n) WHERE cnt.n < 3) SELECT n FROM cnt ORDER BY n;

# Recursive step with IN subquery, which can introduce MARK joins.
statement ok
WITH RECURSIVE cnt(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM cnt WHERE n < 4 AND n IN (SELECT n FROM recursive_allowed)) SELECT n FROM cnt ORDER BY n;

# Recursive inline VALUES scans need the same table-function column alias as flat CTE scans.
statement ok
WITH RECURSIVE cnt(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM cnt WHERE n < (SELECT max(c0) FROM (VALUES (3)) v(c0))) SELECT n FROM cnt ORDER BY n;

# --- WITH RECURSIVE ... USING KEY is refused: it keeps only the latest row per key across iterations,
# which a plain recursive CTE does not reproduce. ---
statement error
SELECT sql FROM lpts_query('WITH RECURSIVE cte(x,y) USING KEY (x) AS (SELECT 1, 0 UNION ALL SELECT x, y+1 FROM cte WHERE y < 10) TABLE cte');
----
LPTS_UNSUPPORTED_RECURSIVE_CTE
