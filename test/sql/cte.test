# name: test/sql/cte.test
# description: test lpts with CHUNK_GET, CTE_REF, MATERIALIZED_CTE, CTE_INLINING, NOT MATERIALIZED, nested CTEs, and WITH RECURSIVE
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE t (id INTEGER, val INTEGER, label VARCHAR);

statement ok
INSERT INTO t VALUES (1, 10, 'a'), (2, 20, 'b'), (3, 30, 'c'), (4, 40, 'd'), (5, 50, 'e');

# ============================================================
# CHUNK_GET: IN with 5 literal values → MARK JOIN via VALUES scan
# ============================================================

query II rowsort
SELECT id, val FROM t WHERE val IN (10, 20, 30, 40, 50);
----
1	10
2	20
3	30
4	40
5	50

statement ok
SELECT id, val FROM t WHERE val IN (10, 20, 30, 40, 50);

# --- partial match ---

query II rowsort
SELECT id, val FROM t WHERE val IN (10, 30, 50);
----
1	10
3	30
5	50

statement ok
SELECT id, val FROM t WHERE val IN (10, 30, 50);

# --- NOT IN: produces an ANTI join; no rows match when all values are listed ---

query II
SELECT id, val FROM t WHERE val NOT IN (10, 20, 30, 40, 50);
----

statement ok
SELECT id, val FROM t WHERE val NOT IN (10, 20, 30, 40, 50);

# ============================================================
# MATERIALIZED_CTE + CTE_REF x2: WITH clause used twice
# DuckDB materializes the CTE body and scans it via two CTE_REF nodes.
# ============================================================

# CTE appears in both the outer SELECT and a correlated subquery
query II
WITH high AS (SELECT id, val FROM t WHERE val >= 30) SELECT h1.id, h1.val FROM high h1 WHERE h1.val = (SELECT max(val) FROM high);
----
5	50

statement ok
WITH high AS (SELECT id, val FROM t WHERE val >= 30) SELECT h1.id, h1.val FROM high h1 WHERE h1.val = (SELECT max(val) FROM high);

# CTE self-joined
query I rowsort
WITH numbered AS (SELECT id, val FROM t) SELECT a.id FROM numbered a JOIN numbered b ON a.id = b.id WHERE a.val > 20;
----
3
4
5

statement ok
WITH numbered AS (SELECT id, val FROM t) SELECT a.id FROM numbered a JOIN numbered b ON a.id = b.id WHERE a.val > 20;

# Chained CTEs (base → derived): each CTE used once, no materialization
query II
WITH base AS (SELECT id, val FROM t WHERE val > 10), doubled AS (SELECT id, val * 2 AS val FROM base) SELECT id, val FROM doubled ORDER BY id;
----
2	40
3	60
4	80
5	100

statement ok
WITH base AS (SELECT id, val FROM t WHERE val > 10), doubled AS (SELECT id, val * 2 AS val FROM base) SELECT id, val FROM doubled ORDER BY id;
# A long single-use CTE chain needs a real boundary so DuckDB's decorrelator
# does not traverse the whole inlined chain on a worker's small stack.
query I
SELECT contains(sql, 'AS MATERIALIZED (')::INT FROM lpts_query($$
WITH
    c0 AS (SELECT id AS x FROM t),
    c1 AS (SELECT x + 1 AS x FROM c0),
    c2 AS (SELECT x + 1 AS x FROM c1),
    c3 AS (SELECT x + 1 AS x FROM c2),
    c4 AS (SELECT x + 1 AS x FROM c3),
    c5 AS (SELECT x + 1 AS x FROM c4),
    c6 AS (SELECT x + 1 AS x FROM c5),
    c7 AS (SELECT x + 1 AS x FROM c6),
    c8 AS (SELECT x + 1 AS x FROM c7),
    c9 AS (SELECT x + 1 AS x FROM c8),
    c10 AS (SELECT x + 1 AS x FROM c9),
    c11 AS (SELECT x + 1 AS x FROM c10),
    c12 AS (SELECT x + 1 AS x FROM c11),
    c13 AS (SELECT x + 1 AS x FROM c12),
    c14 AS (SELECT x + 1 AS x FROM c13),
    c15 AS (SELECT x + 1 AS x FROM c14),
    c16 AS (SELECT x + 1 AS x FROM c15),
    c17 AS (SELECT x + 1 AS x FROM c16),
    c18 AS (SELECT x + 1 AS x FROM c17),
    c19 AS (SELECT x + 1 AS x FROM c18),
    c20 AS (SELECT x + 1 AS x FROM c19),
    c21 AS (SELECT x + 1 AS x FROM c20),
    c22 AS (SELECT x + 1 AS x FROM c21),
    c23 AS (SELECT x + 1 AS x FROM c22),
    c24 AS (SELECT x + 1 AS x FROM c23),
    c25 AS (SELECT x + 1 AS x FROM c24),
    c26 AS (SELECT x + 1 AS x FROM c25),
    c27 AS (SELECT x + 1 AS x FROM c26),
    c28 AS (SELECT x + 1 AS x FROM c27),
    c29 AS (SELECT x + 1 AS x FROM c28),
    c30 AS (SELECT x + 1 AS x FROM c29),
    c31 AS (SELECT x + 1 AS x FROM c30),
    c32 AS (SELECT x + 1 AS x FROM c31),
    c33 AS (SELECT x + 1 AS x FROM c32),
    c34 AS (SELECT x + 1 AS x FROM c33),
    c35 AS (SELECT x + 1 AS x FROM c34),
    c36 AS (SELECT x + 1 AS x FROM c35),
    c37 AS (SELECT x + 1 AS x FROM c36),
    c38 AS (SELECT x + 1 AS x FROM c37),
    c39 AS (SELECT x + 1 AS x FROM c38)
SELECT x FROM c39
$$);
