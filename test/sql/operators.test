# name: test/sql/operators.test
# description: test lpts with BOUND_OPERATOR (IS NULL, IS NOT NULL, IN, NOT IN, NOT, COALESCE, NULLIF) and BOUND_CASE (CASE WHEN)
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE t (id INTEGER, val INTEGER, name VARCHAR);

statement ok
INSERT INTO t VALUES (1, 10, 'Alice'), (2, NULL, 'Bob'), (3, 30, NULL), (4, 20, 'Dave');

# ============================================================
# IS NULL / IS NOT NULL
# ============================================================

# --- IS NULL in WHERE filter ---

query I
SELECT id FROM t WHERE val IS NULL;
----
2

statement ok
SELECT id FROM t WHERE val IS NULL;

# --- IS NOT NULL in WHERE filter ---

query I rowsort
SELECT id FROM t WHERE name IS NOT NULL;
----
1
2
4

statement ok
SELECT id FROM t WHERE name IS NOT NULL;

# --- IS NULL on projected expression ---

statement ok
SELECT id, val IS NULL AS is_missing FROM t;

# ============================================================
# IN / NOT IN
# ============================================================

# --- IN with literal list ---

query I rowsort
SELECT id FROM t WHERE val IN (10, 30);
----
1
3

statement ok
SELECT id FROM t WHERE val IN (10, 30);

# --- NOT IN with literal list ---

query I
SELECT id FROM t WHERE val NOT IN (10, 30);
----
4

statement ok
SELECT id FROM t WHERE val NOT IN (10, 30);

# --- IN with single value ---

query I
SELECT id FROM t WHERE val IN (20);
----
4

statement ok
SELECT id FROM t WHERE val IN (20);

# ============================================================
# NOT operator
# ============================================================

# --- NOT (IS NULL) ---

query I rowsort
SELECT id FROM t WHERE NOT (val IS NULL);
----
1
3
4

statement ok
SELECT id FROM t WHERE NOT (val IS NULL);

# --- NOT with comparison ---

query I rowsort
SELECT id FROM t WHERE NOT (val > 15);
----
1

statement ok
SELECT id FROM t WHERE NOT (val > 15);

# ============================================================
# COALESCE
# ============================================================

# --- COALESCE in projection ---

query II rowsort
SELECT id, COALESCE(val, 0) AS v FROM t;
----
1	10
2	0
3	30
4	20

statement ok
SELECT id, COALESCE(val, 0) AS v FROM t;

# --- COALESCE in WHERE filter ---

query II rowsort
SELECT id, COALESCE(val, 0) AS v FROM t WHERE COALESCE(val, 0) > 15;
----
3	30
4	20

statement ok
SELECT id, COALESCE(val, 0) AS v FROM t WHERE COALESCE(val, 0) > 15;

# ============================================================
# NULLIF
# ============================================================

# --- NULLIF in projection ---

query II rowsort
SELECT id, NULLIF(val, 10) AS v FROM t;
----
1	NULL
2	NULL
3	30
4	20

statement ok
SELECT id, NULLIF(val, 10) AS v FROM t;

# ============================================================
# CASE WHEN (BOUND_CASE)
# ============================================================

# --- CASE WHEN with two branches and ELSE ---

query II rowsort
SELECT id, CASE WHEN val > 25 THEN 'high' WHEN val > 10 THEN 'mid' ELSE 'low' END AS band FROM t;
----
1	low
2	low
3	high
4	mid

statement ok
SELECT id, CASE WHEN val > 25 THEN 'high' WHEN val > 10 THEN 'mid' ELSE 'low' END AS band FROM t;

# --- CASE WHEN with IS NULL check ---

query II rowsort
SELECT id, CASE WHEN val IS NULL THEN 0 ELSE val END AS safe_val FROM t;
----
1	10
2	0
3	30
4	20

statement ok
SELECT id, CASE WHEN val IS NULL THEN 0 ELSE val END AS safe_val FROM t;

# --- CASE WHEN in WHERE (via aggregate) ---

statement ok
SELECT sum(CASE WHEN val > 10 THEN val ELSE 0 END) FROM t;

# --- CASE WHEN in GROUP BY aggregate ---

statement ok
CREATE TABLE orders (region VARCHAR, amount INTEGER, priority VARCHAR);

statement ok
INSERT INTO orders VALUES
  ('US', 100, '1-URGENT'), ('US', 200, '2-HIGH'), ('US', 50, '3-LOW'),
  ('EU', 300, '1-URGENT'), ('EU', 150, '3-LOW');

query II rowsort
SELECT region, sum(CASE WHEN priority = '1-URGENT' THEN amount ELSE 0 END) AS urgent_total FROM orders GROUP BY region;
----
EU	300
US	100

statement ok
SELECT region, sum(CASE WHEN priority = '1-URGENT' THEN amount ELSE 0 END) AS urgent_total FROM orders GROUP BY region;

# ============================================================
# Combined: CASE + IN
# ============================================================

statement ok
SELECT id, CASE WHEN val IN (10, 20) THEN 'small' ELSE 'large' END AS sz FROM t;

# ============================================================
# Postgres dialect: table reference without catalog/schema prefix
# ============================================================

query I
SELECT sql LIKE '%memory.main.t%' AS uses_catalog FROM lpts_query('SELECT id FROM t WHERE val IS NULL');
----
true

statement ok
SET lpts_dialect = 'postgres';

query I
SELECT sql LIKE '%memory.main.t%' AS uses_catalog FROM lpts_query('SELECT id FROM t WHERE val IS NULL');
----
false

statement ok
SELECT id FROM t WHERE val IS NULL;

statement ok
SET lpts_dialect = 'duckdb';
