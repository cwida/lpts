# name: test/sql/optimizer.test
# description: test lpts with optimizers enabled and selectively disabled — STATISTICS_PROPAGATION effects and FILTER_PUSHDOWN, JOIN_ORDER, TOP_N
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE t (id INTEGER, val INTEGER, label VARCHAR);

statement ok
INSERT INTO t VALUES (1, 10, 'x'), (2, 20, 'x'), (3, 30, 'y'), (4, 40, 'y'), (5, 50, 'z');

statement ok
CREATE TABLE t2 (id INTEGER, score INTEGER);

statement ok
INSERT INTO t2 VALUES (1, 100), (2, 200), (3, 300);

# ============================================================
# FILTER_PUSHDOWN disabled
# Filters are not pushed below joins; they stay as separate
# FilterNodes above the join in the logical plan.
# ============================================================

statement ok
SET disabled_optimizers = 'FILTER_PUSHDOWN';

statement ok
SELECT id, val FROM t WHERE val > 20;

statement ok
SELECT id, val FROM t WHERE val > 10 AND label = 'x';

statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10 AND t2.score < 300;

statement ok
SELECT label, sum(val) FROM t GROUP BY label HAVING sum(val) > 30;

statement ok
SET disabled_optimizers = '';

# ============================================================
# JOIN_ORDER disabled
# DuckDB preserves the join order as written rather than
# reordering for cardinality; LPTS must still convert correctly.
# ============================================================

statement ok
SET disabled_optimizers = 'JOIN_ORDER';

statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id;

statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 20;

statement ok
SET disabled_optimizers = '';

# ============================================================
# FILTER_PUSHDOWN + JOIN_ORDER disabled together
# ============================================================

statement ok
SET disabled_optimizers = 'FILTER_PUSHDOWN,JOIN_ORDER';

statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10;

statement ok
SELECT label, sum(val) FROM t GROUP BY label HAVING sum(val) > 30;

statement ok
SET disabled_optimizers = '';

# ============================================================
# REORDER_FILTER enabled
# ExpressionHeuristics reorders filter expressions by cost.
# LPTS serializes all conditions regardless of order, so
# correctness must be unaffected.
# ============================================================

statement ok
SELECT id, val FROM t WHERE val > 10 AND label = 'x' AND id < 5;

statement ok
SELECT label, sum(val) FROM t WHERE val > 10 AND label <> 'z' GROUP BY label HAVING sum(val) > 20;

statement ok
SET disabled_optimizers = 'REORDER_FILTER';

statement ok
SELECT id, val FROM t WHERE val > 10 AND label = 'x' AND id < 5;

statement ok
SELECT label, sum(val) FROM t WHERE val > 10 AND label <> 'z' GROUP BY label HAVING sum(val) > 20;

statement ok
SET disabled_optimizers = '';

# ============================================================
# JOIN_FILTER_PUSHDOWN enabled
# Attaches runtime JoinFilterPushdownInfo to join nodes and
# DynamicTableFilterSet to scan nodes. LPTS does not read
# either field, so the logical plan conversion is unaffected.
# ============================================================

statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id;

statement ok
SELECT t.id, t.val, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10 AND t2.score < 300;

statement ok
SELECT t.label, sum(t.val), max(t2.score) FROM t JOIN t2 ON t.id = t2.id GROUP BY t.label;

statement ok
SET disabled_optimizers = 'JOIN_FILTER_PUSHDOWN';

statement ok
SELECT t.id, t.val, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10 AND t2.score < 300;

statement ok
SET disabled_optimizers = '';

# ============================================================
# TOP_N enabled (default)
# ORDER BY + constant LIMIT fused into LogicalTopN by DuckDB.
# LPTS serializes it as ORDER BY ... LIMIT in the CTE body.
# ============================================================

statement ok
SELECT id, val FROM t ORDER BY val DESC LIMIT 3;

statement ok
SELECT id, val FROM t ORDER BY val LIMIT 2 OFFSET 1;

statement ok
SELECT label, sum(val) AS s FROM t GROUP BY label ORDER BY s DESC LIMIT 2;

statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id ORDER BY t2.score LIMIT 2;

# ============================================================
# Optimizer re-enabled: same queries must still pass
# ============================================================

statement ok
SELECT id, val FROM t WHERE val > 20;

statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10;

# ============================================================
# STATISTICS_PROPAGATION enabled (default)
#
# Impossible-predicate pruning → LOGICAL_EMPTY_RESULT
# When a filter can never be satisfied given column statistics,
# STATISTICS_PROPAGATION replaces the subtree with an EMPTY_RESULT
# node. LPTS serialises it as a "(SELECT 1) WHERE false" subquery.
# ============================================================

# Constant-false predicate: WHERE 1 = 0
statement ok
SELECT id, val FROM t WHERE 1 = 0;

query II
SELECT id, val FROM t WHERE 1 = 0;
----

# Column out-of-range: val ∈ [10, 50], so val < 0 is impossible
statement ok
SELECT id, val FROM t WHERE val < 0;

query II
SELECT id, val FROM t WHERE val < 0;
----

# Boundary: val > 50 is impossible (max = 50)
statement ok
SELECT id, val FROM t WHERE val > 50;

query II
SELECT id, val FROM t WHERE val > 50;
----

# Impossible range: val < 10 AND val > 50 — contradictory, pruned to EMPTY_RESULT
statement ok
SELECT id, val FROM t WHERE val < 10 AND val > 50;

query II
SELECT id, val FROM t WHERE val < 10 AND val > 50;
----

# ============================================================
# Always-true filter removal
#
# When statistics prove a filter always passes, it is removed
# from the scan entirely. The LPTS-generated SQL must still
# return all rows.
# ============================================================

# Constant-true predicate: WHERE 1 = 1
statement ok
SELECT id, val FROM t WHERE 1 = 1;

query II
SELECT id, val FROM t WHERE 1 = 1;
----
1	10
2	20
3	30
4	40
5	50

# Column always in range: val ∈ [10, 50], so val >= 10 is always true
statement ok
SELECT id, val FROM t WHERE val >= 10;

query II
SELECT id, val FROM t WHERE val >= 10;
----
1	10
2	20
3	30
4	40
5	50

# ============================================================
# Join stats: scan filter added from join partner statistics
# ============================================================

statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id;

query II
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id;
----
1	100
2	200
3	300

statement ok
SELECT t.id, t.val, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10;

query III
SELECT t.id, t.val, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10;
----
2	20	200
3	30	300

# Impossible predicate on a join — EMPTY_RESULT propagates up
statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.id > 100;

query II
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.id > 100;
----

# Aggregate on pruned input → zero-row aggregate result
statement ok
SELECT count(*), sum(val) FROM t WHERE val > 50;

query II
SELECT count(*), sum(val) FROM t WHERE val > 50;
----
0	NULL

# ============================================================
# STATISTICS_PROPAGATION deliberately disabled
# Without stats, impossible filters are not pruned — plan
# contains a real scan + filter node, still correct.
# ============================================================

statement ok
SET disabled_optimizers = 'STATISTICS_PROPAGATION';

statement ok
SELECT id, val FROM t WHERE val < 0;

query II
SELECT id, val FROM t WHERE val < 0;
----

statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id;

statement ok
SET disabled_optimizers = '';

# ============================================================
# COLUMN_LIFETIME
# Prunes unused output columns from LogicalFilter, LogicalOrder,
# and LogicalComparisonJoin via projection_map. FilterNode and
# OrderNode emit an explicit SELECT column list so the CTE
# header column count always matches the body — even when
# COLUMN_LIFETIME removes sort/filter keys from the output.
# ============================================================

# ORDER BY on a column that is NOT in the SELECT list.
# COLUMN_LIFETIME prunes the sort key (val) from the ORDER CTE output.
statement ok
SELECT id FROM t ORDER BY val;

statement ok
SELECT id FROM t ORDER BY val DESC;

# ORDER BY on multiple non-selected columns.
statement ok
SELECT id FROM t ORDER BY val DESC, label ASC;

# Filter where the condition column is not in the SELECT list.
statement ok
SELECT id FROM t WHERE val > 20;

# Join: sort key from the right side pruned from ORDER CTE output.
statement ok
SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id ORDER BY t2.score;

statement ok
SELECT t.id FROM t JOIN t2 ON t.id = t2.id ORDER BY t2.score;

# Regression: a FILTER above a barrier (aggregate / unnest) where COLUMN_LIFETIME prunes a
# column at the filter via projection_map (the group key / list passthrough is only needed
# below the filter). FilterNode must emit only the kept columns; emitting the pruned column
# leaves the CTE body wider than its header, which breaks the moment the filter output feeds
# an arity-sensitive parent — here a UNION ALL with a 1-column branch.
statement ok
SELECT total FROM (SELECT label, SUM(val) AS total FROM t GROUP BY label) s WHERE total > 25 UNION ALL SELECT 99;

# Same filter-prunes-group-key shape without the set-op.
statement ok
SELECT total FROM (SELECT label, SUM(val) AS total FROM t GROUP BY label) s WHERE total > 25;

# FILTER above UNNEST: the list passthrough column is pruned at the filter.
statement ok
CREATE TABLE arr_t (id INTEGER, arr INTEGER[]);

statement ok
INSERT INTO arr_t VALUES (1, [5, 15, 20]), (2, [3, 30]);

statement ok
SELECT elem FROM (SELECT unnest(arr) AS elem FROM arr_t) u WHERE elem > 10 UNION ALL SELECT 99;

# COLUMN_LIFETIME disabled: same queries must still round-trip correctly.
statement ok
SET disabled_optimizers = 'COLUMN_LIFETIME';

statement ok
SELECT id FROM t ORDER BY val;

statement ok
SELECT id FROM t WHERE val > 20;

statement ok
SELECT t.id FROM t JOIN t2 ON t.id = t2.id ORDER BY t2.score;

statement ok
SELECT total FROM (SELECT label, SUM(val) AS total FROM t GROUP BY label) s WHERE total > 25 UNION ALL SELECT 99;

statement ok
SET disabled_optimizers = '';
