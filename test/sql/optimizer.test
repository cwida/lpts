# name: test/sql/optimizer.test
# description: test lpts with optimizers enabled and selectively disabled — STATISTICS_PROPAGATION effects and FILTER_PUSHDOWN, JOIN_ORDER, TOP_N
# group: [sql]

require lpts

statement ok
CREATE TABLE t (id INTEGER, val INTEGER, label VARCHAR);

statement ok
INSERT INTO t VALUES (1, 10, 'x'), (2, 20, 'x'), (3, 30, 'y'), (4, 40, 'y'), (5, 50, 'z');

statement ok
CREATE TABLE t2 (id INTEGER, score INTEGER);

statement ok
INSERT INTO t2 VALUES (1, 100), (2, 200), (3, 300);

# ============================================================
# FILTER_PUSHDOWN disabled
# Filters are not pushed below joins; they stay as separate
# FilterNodes above the join in the logical plan.
# ============================================================

statement ok
SET disabled_optimizers = 'FILTER_PUSHDOWN';

query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE val > 20');
----
true

query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE val > 10 AND label = ''x''');
----
true

query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10 AND t2.score < 300');
----
true

query I
PRAGMA lpts_check('SELECT label, sum(val) FROM t GROUP BY label HAVING sum(val) > 30');
----
true

statement ok
SET disabled_optimizers = '';

# ============================================================
# JOIN_ORDER disabled
# DuckDB preserves the join order as written rather than
# reordering for cardinality; LPTS must still convert correctly.
# ============================================================

statement ok
SET disabled_optimizers = 'JOIN_ORDER';

query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id');
----
true

query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 20');
----
true

statement ok
SET disabled_optimizers = '';

# ============================================================
# FILTER_PUSHDOWN + JOIN_ORDER disabled together
# ============================================================

statement ok
SET disabled_optimizers = 'FILTER_PUSHDOWN,JOIN_ORDER';

query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10');
----
true

query I
PRAGMA lpts_check('SELECT label, sum(val) FROM t GROUP BY label HAVING sum(val) > 30');
----
true

statement ok
SET disabled_optimizers = '';

# ============================================================
# REORDER_FILTER enabled
# ExpressionHeuristics reorders filter expressions by cost.
# LPTS serializes all conditions regardless of order, so
# correctness must be unaffected.
# ============================================================

query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE val > 10 AND label = ''x'' AND id < 5');
----
true

query I
PRAGMA lpts_check('SELECT label, sum(val) FROM t WHERE val > 10 AND label <> ''z'' GROUP BY label HAVING sum(val) > 20');
----
true

statement ok
SET disabled_optimizers = 'REORDER_FILTER';

query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE val > 10 AND label = ''x'' AND id < 5');
----
true

query I
PRAGMA lpts_check('SELECT label, sum(val) FROM t WHERE val > 10 AND label <> ''z'' GROUP BY label HAVING sum(val) > 20');
----
true

statement ok
SET disabled_optimizers = '';

# ============================================================
# JOIN_FILTER_PUSHDOWN enabled
# Attaches runtime JoinFilterPushdownInfo to join nodes and
# DynamicTableFilterSet to scan nodes. LPTS does not read
# either field, so the logical plan conversion is unaffected.
# ============================================================

query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id');
----
true

query I
PRAGMA lpts_check('SELECT t.id, t.val, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10 AND t2.score < 300');
----
true

query I
PRAGMA lpts_check('SELECT t.label, sum(t.val), max(t2.score) FROM t JOIN t2 ON t.id = t2.id GROUP BY t.label');
----
true

statement ok
SET disabled_optimizers = 'JOIN_FILTER_PUSHDOWN';

query I
PRAGMA lpts_check('SELECT t.id, t.val, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10 AND t2.score < 300');
----
true

statement ok
SET disabled_optimizers = '';

# ============================================================
# TOP_N enabled (default)
# ORDER BY + constant LIMIT fused into LogicalTopN by DuckDB.
# LPTS serializes it as ORDER BY ... LIMIT in the CTE body.
# ============================================================

query I
PRAGMA lpts_check('SELECT id, val FROM t ORDER BY val DESC LIMIT 3');
----
true

query I
PRAGMA lpts_check('SELECT id, val FROM t ORDER BY val LIMIT 2 OFFSET 1');
----
true

query I
PRAGMA lpts_check('SELECT label, sum(val) AS s FROM t GROUP BY label ORDER BY s DESC LIMIT 2');
----
true

query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id ORDER BY t2.score LIMIT 2');
----
true

# ============================================================
# Optimizer re-enabled: same queries must still pass
# ============================================================

query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE val > 20');
----
true

query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10');
----
true

# ============================================================
# STATISTICS_PROPAGATION enabled (default)
#
# Impossible-predicate pruning → LOGICAL_EMPTY_RESULT
# When a filter can never be satisfied given column statistics,
# STATISTICS_PROPAGATION replaces the subtree with an EMPTY_RESULT
# node. LPTS serialises it as a "(SELECT 1) WHERE false" subquery.
# ============================================================

# Constant-false predicate: WHERE 1 = 0
query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE 1 = 0');
----
true

query II
PRAGMA lpts_exec('SELECT id, val FROM t WHERE 1 = 0');
----

# Column out-of-range: val ∈ [10, 50], so val < 0 is impossible
query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE val < 0');
----
true

query II
PRAGMA lpts_exec('SELECT id, val FROM t WHERE val < 0');
----

# Boundary: val > 50 is impossible (max = 50)
query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE val > 50');
----
true

query II
PRAGMA lpts_exec('SELECT id, val FROM t WHERE val > 50');
----

# Impossible range: val < 10 AND val > 50 — contradictory, pruned to EMPTY_RESULT
query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE val < 10 AND val > 50');
----
true

query II
PRAGMA lpts_exec('SELECT id, val FROM t WHERE val < 10 AND val > 50');
----

# ============================================================
# Always-true filter removal
#
# When statistics prove a filter always passes, it is removed
# from the scan entirely. The LPTS-generated SQL must still
# return all rows.
# ============================================================

# Constant-true predicate: WHERE 1 = 1
query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE 1 = 1');
----
true

query II
PRAGMA lpts_exec('SELECT id, val FROM t WHERE 1 = 1');
----
1	10
2	20
3	30
4	40
5	50

# Column always in range: val ∈ [10, 50], so val >= 10 is always true
query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE val >= 10');
----
true

query II
PRAGMA lpts_exec('SELECT id, val FROM t WHERE val >= 10');
----
1	10
2	20
3	30
4	40
5	50

# ============================================================
# Join stats: scan filter added from join partner statistics
# ============================================================

query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id');
----
true

query II
PRAGMA lpts_exec('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id');
----
1	100
2	200
3	300

query I
PRAGMA lpts_check('SELECT t.id, t.val, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10');
----
true

query III
PRAGMA lpts_exec('SELECT t.id, t.val, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.val > 10');
----
2	20	200
3	30	300

# Impossible predicate on a join — EMPTY_RESULT propagates up
query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.id > 100');
----
true

query II
PRAGMA lpts_exec('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id WHERE t.id > 100');
----

# Aggregate on pruned input → zero-row aggregate result
query I
PRAGMA lpts_check('SELECT count(*), sum(val) FROM t WHERE val > 50');
----
true

query II
PRAGMA lpts_exec('SELECT count(*), sum(val) FROM t WHERE val > 50');
----
0	NULL

# ============================================================
# STATISTICS_PROPAGATION deliberately disabled
# Without stats, impossible filters are not pruned — plan
# contains a real scan + filter node, still correct.
# ============================================================

statement ok
SET disabled_optimizers = 'STATISTICS_PROPAGATION';

query I
PRAGMA lpts_check('SELECT id, val FROM t WHERE val < 0');
----
true

query II
PRAGMA lpts_exec('SELECT id, val FROM t WHERE val < 0');
----

query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id');
----
true

statement ok
SET disabled_optimizers = '';

# ============================================================
# COLUMN_LIFETIME
# Prunes unused output columns from LogicalFilter, LogicalOrder,
# and LogicalComparisonJoin via projection_map. FilterNode and
# OrderNode emit an explicit SELECT column list so the CTE
# header column count always matches the body — even when
# COLUMN_LIFETIME removes sort/filter keys from the output.
# ============================================================

# ORDER BY on a column that is NOT in the SELECT list.
# COLUMN_LIFETIME prunes the sort key (val) from the ORDER CTE output.
query I
PRAGMA lpts_check('SELECT id FROM t ORDER BY val');
----
true

query I
PRAGMA lpts_check('SELECT id FROM t ORDER BY val DESC');
----
true

# ORDER BY on multiple non-selected columns.
query I
PRAGMA lpts_check('SELECT id FROM t ORDER BY val DESC, label ASC');
----
true

# Filter where the condition column is not in the SELECT list.
query I
PRAGMA lpts_check('SELECT id FROM t WHERE val > 20');
----
true

# Join: sort key from the right side pruned from ORDER CTE output.
query I
PRAGMA lpts_check('SELECT t.id, t2.score FROM t JOIN t2 ON t.id = t2.id ORDER BY t2.score');
----
true

query I
PRAGMA lpts_check('SELECT t.id FROM t JOIN t2 ON t.id = t2.id ORDER BY t2.score');
----
true

# Regression: a FILTER above a barrier (aggregate / unnest) where COLUMN_LIFETIME prunes a
# column at the filter via projection_map (the group key / list passthrough is only needed
# below the filter). FilterNode must emit only the kept columns; emitting the pruned column
# leaves the CTE body wider than its header, which breaks the moment the filter output feeds
# an arity-sensitive parent — here a UNION ALL with a 1-column branch.
query I
PRAGMA lpts_check('SELECT total FROM (SELECT label, SUM(val) AS total FROM t GROUP BY label) s WHERE total > 25 UNION ALL SELECT 99');
----
true

# Same filter-prunes-group-key shape without the set-op.
query I
PRAGMA lpts_check('SELECT total FROM (SELECT label, SUM(val) AS total FROM t GROUP BY label) s WHERE total > 25');
----
true

# FILTER above UNNEST: the list passthrough column is pruned at the filter.
statement ok
CREATE TABLE arr_t (id INTEGER, arr INTEGER[]);

statement ok
INSERT INTO arr_t VALUES (1, [5, 15, 20]), (2, [3, 30]);

query I
PRAGMA lpts_check('SELECT elem FROM (SELECT unnest(arr) AS elem FROM arr_t) u WHERE elem > 10 UNION ALL SELECT 99');
----
true

# COLUMN_LIFETIME disabled: same queries must still round-trip correctly.
statement ok
SET disabled_optimizers = 'COLUMN_LIFETIME';

query I
PRAGMA lpts_check('SELECT id FROM t ORDER BY val');
----
true

query I
PRAGMA lpts_check('SELECT id FROM t WHERE val > 20');
----
true

query I
PRAGMA lpts_check('SELECT t.id FROM t JOIN t2 ON t.id = t2.id ORDER BY t2.score');
----
true

query I
PRAGMA lpts_check('SELECT total FROM (SELECT label, SUM(val) AS total FROM t GROUP BY label) s WHERE total > 25 UNION ALL SELECT 99');
----
true

statement ok
SET disabled_optimizers = '';
