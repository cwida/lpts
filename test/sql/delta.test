# name: test/sql/delta.test
# description: test LPTS with Delta Lake scans and attached Delta catalogs
# group: [sql]

require lpts

require parquet

require delta

statement ok
LOAD parquet;

statement ok
LOAD delta;

# ==========================================
# Direct delta_scan table function
# ==========================================

query I
PRAGMA lpts_check('SELECT count(*) FROM delta_scan(''test/data/delta_basic'')');
----
true

query I
PRAGMA lpts_check('SELECT name FROM delta_scan(''test/data/delta_basic'') WHERE id > 1 ORDER BY name');
----
true

query I
PRAGMA lpts_check('SELECT id + 10 AS shifted_id, upper(name) AS upper_name FROM delta_scan(''test/data/delta_basic'') WHERE name <> ''bob'' ORDER BY shifted_id DESC');
----
true

query I
PRAGMA lpts_check('SELECT id % 2 AS parity, count(*) AS cnt, string_agg(name, '','' ORDER BY name) AS names FROM delta_scan(''test/data/delta_basic'') GROUP BY parity ORDER BY parity');
----
true

query I
PRAGMA lpts_check('WITH d AS (SELECT id, name FROM delta_scan(''test/data/delta_basic'') WHERE id >= 2) SELECT name FROM d WHERE length(name) > 3 ORDER BY id');
----
true

query I
PRAGMA lpts_check('SELECT d.name, v.label FROM delta_scan(''test/data/delta_basic'') d JOIN (VALUES (1, ''one''), (2, ''two''), (3, ''three'')) v(id, label) USING (id) ORDER BY d.id');
----
true

query I
PRAGMA lpts_check('SELECT name FROM delta_scan(''test/data/delta_basic'') WHERE id IN (SELECT id FROM (VALUES (1), (3)) v(id)) ORDER BY name');
----
true

# ==========================================
# Attached Delta catalog scan
# ==========================================

statement ok
ATTACH 'test/data/delta_basic' AS lpts_delta (TYPE delta);

query I
PRAGMA lpts_check('SELECT name FROM lpts_delta WHERE id >= 2 ORDER BY id');
----
true

query I
PRAGMA lpts_check('SELECT count(*), max(id) FROM lpts_delta');
----
true

query I
PRAGMA lpts_check('SELECT id, name FROM lpts_delta WHERE id BETWEEN 1 AND 3 ORDER BY id LIMIT 2 OFFSET 1');
----
true

query I
PRAGMA lpts_check('SELECT d.name, v.label FROM lpts_delta d LEFT JOIN (VALUES (1, ''one''), (4, ''four'')) v(id, label) USING (id) ORDER BY d.id');
----
true

query I
PRAGMA lpts_check('SELECT name FROM lpts_delta WHERE id = (SELECT max(id) FROM lpts_delta)');
----
true

# ==========================================
# Delta time travel
# ==========================================

query I
PRAGMA lpts_check('SELECT name FROM lpts_delta.main.lpts_delta AT (VERSION => 0) ORDER BY id');
----
true

query I
PRAGMA lpts_check('SELECT count(*), max(id) FROM lpts_delta.main.lpts_delta AT (VERSION => 0)');
----
true

query I
PRAGMA lpts_check('SELECT cur.name FROM lpts_delta cur ANTI JOIN (SELECT id FROM lpts_delta.main.lpts_delta AT (VERSION => 0)) old USING (id) ORDER BY cur.id');
----
true
