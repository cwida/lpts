# name: test/sql/print_ast.test
# description: test print_ast_query table function
# group: [sql]

require lpts

statement ok
CREATE TABLE users (id INTEGER, name VARCHAR, age INTEGER);

statement ok
CREATE TABLE orders (id INTEGER, user_id INTEGER, amount DECIMAL);

# Simple select — should produce Project → Get
query I
SELECT replace(ast, chr(10), ' | ') FROM print_ast_query('SELECT * FROM users');
----
Project (table_index=1, expressions=3) |   t1_id <- t0_id |   t1_name <- t0_name |   t1_age <- t0_age |   Get memory.main.users (table_index=0) |     columns: [id, name, age]

# Select with filter on empty table — STATISTICS_PROPAGATION detects the table is empty
# (column stats have inverted min/max), so it prunes the whole plan to EMPTY_RESULT.
query I
SELECT replace(ast, chr(10), ' | ') FROM print_ast_query('SELECT * FROM users WHERE age > 25');
----
Get ..(SELECT 1) (table_index=0) |   columns: [NULL::INTEGER, NULL::VARCHAR, NULL::INTEGER] |   filters: [false]

# Filter pushdown on a populated table — FILTER_PUSHDOWN folds the condition into
# the scan's table_filters and STATISTICS_PROPAGATION keeps it (age range [20,30]
# straddles 25, so the filter is neither always-true nor always-false).
statement ok
CREATE TABLE users_pop (id INTEGER, name VARCHAR, age INTEGER);

statement ok
INSERT INTO users_pop VALUES (1, 'Alice', 20), (2, 'Bob', 30);

query I
SELECT replace(ast, chr(10), ' | ') FROM print_ast_query('SELECT * FROM users_pop WHERE age > 25');
----
Project (table_index=1, expressions=3) |   t1_id <- t0_id |   t1_name <- t0_name |   t1_age <- t0_age |   Get memory.main.users_pop (table_index=0) |     columns: [age, id, name] |     filters: [age>25]

# Join — should produce Project → Aggregate → Join → Get + Get
query I
SELECT replace(ast, chr(10), ' | ') FROM print_ast_query('SELECT u.name, sum(o.amount) FROM users u JOIN orders o ON u.id = o.user_id GROUP BY u.name');
----
Project (table_index=2, expressions=2) |   t2_name <- t3_name |   t2_aggregate_0 <- t4_aggregate_0 |   Aggregate (groups=1, aggregates=1) |     group_by: [t0_name] |     t4_aggregate_0 <- sum(t1_amount) |     Join (INNER, conditions=1) |       on: (t0_id = t1_user_id) |       Get memory.main.users (table_index=0) |         columns: [id, name] |       Get memory.main.orders (table_index=1) |         columns: [user_id, amount]

# Cross product — should produce Join(INNER, ON TRUE)
query I
PRAGMA lpts_check('SELECT u.name, o.amount FROM users u CROSS JOIN orders o');
----
true

# Duplicate column names — deduplication in projection
query I
PRAGMA lpts_check('SELECT u.id, o.id FROM users u CROSS JOIN orders o');
----
true

# UNION ALL — AST roundtrip
query I
PRAGMA lpts_check('SELECT id FROM users UNION ALL SELECT user_id FROM orders');
----
true

# Arithmetic in projection — infix rendering
query I
PRAGMA lpts_check('SELECT id + age, age * 2 FROM users');
----
true
