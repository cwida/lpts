# name: test/sql/order_limit.test
# description: test lpts with ORDER BY and LIMIT/OFFSET queries
# group: [sql]

require lpts

statement ok
SET lpts_check=true;

statement ok
CREATE TABLE users (id INTEGER, name VARCHAR, age INTEGER);

statement ok
INSERT INTO users VALUES (1, 'Alice', 30), (2, 'Bob', 25), (3, 'Carol', 35), (4, 'Dave', 25), (5, 'Eve', 30);

# --- ORDER BY single column DESC ---

query III
SELECT id, name, age FROM users ORDER BY age DESC;
----
3	Carol	35
1	Alice	30
5	Eve	30
2	Bob	25
4	Dave	25

statement ok
SELECT id, name, age FROM users ORDER BY age DESC;

# --- ORDER BY single column ASC (default) ---

query III
SELECT id, name, age FROM users ORDER BY age ASC;
----
2	Bob	25
4	Dave	25
1	Alice	30
5	Eve	30
3	Carol	35

statement ok
SELECT id, name, age FROM users ORDER BY age ASC;

# --- ORDER BY multiple columns: primary sort age DESC, secondary name ASC for ties ---

query III
SELECT id, name, age FROM users ORDER BY age DESC, name ASC;
----
3	Carol	35
1	Alice	30
5	Eve	30
2	Bob	25
4	Dave	25

statement ok
SELECT id, name, age FROM users ORDER BY age DESC, name ASC;

# --- ORDER BY: sort on a column not in SELECT ---

query II
SELECT id, name FROM users ORDER BY age DESC, name ASC;
----
3	Carol
1	Alice
5	Eve
2	Bob
4	Dave

statement ok
SELECT id, name FROM users ORDER BY age DESC, name ASC;

# --- ORDER BY string column ---

query I
SELECT name FROM users ORDER BY name ASC;
----
Alice
Bob
Carol
Dave
Eve

statement ok
SELECT name FROM users ORDER BY name ASC;

# --- LIMIT only: return first N rows ---

query II
SELECT id, name FROM users ORDER BY id LIMIT 3;
----
1	Alice
2	Bob
3	Carol

statement ok
SELECT id, name FROM users ORDER BY id LIMIT 3;

# --- LIMIT 1: single row result ---

query II
SELECT id, name FROM users ORDER BY id LIMIT 1;
----
1	Alice

statement ok
SELECT id, name FROM users ORDER BY id LIMIT 1;

# --- LIMIT larger than row count: returns all rows ---

query II
SELECT id, name FROM users ORDER BY id LIMIT 100;
----
1	Alice
2	Bob
3	Carol
4	Dave
5	Eve

statement ok
SELECT id, name FROM users ORDER BY id LIMIT 100;

# --- LIMIT 0: empty result ---

query II
SELECT id, name FROM users ORDER BY id LIMIT 0;
----

statement ok
SELECT id, name FROM users ORDER BY id LIMIT 0;

# --- LIMIT with OFFSET: skip first N rows ---

query II
SELECT id, name FROM users ORDER BY id LIMIT 2 OFFSET 2;
----
3	Carol
4	Dave

statement ok
SELECT id, name FROM users ORDER BY id LIMIT 2 OFFSET 2;

# --- OFFSET only (LIMIT larger than count): skip first row ---

query II
SELECT id, name FROM users ORDER BY id LIMIT 100 OFFSET 4;
----
5	Eve

statement ok
SELECT id, name FROM users ORDER BY id LIMIT 100 OFFSET 4;

# --- OFFSET past end of result: empty ---

query II
SELECT id, name FROM users ORDER BY id LIMIT 10 OFFSET 10;
----

statement ok
SELECT id, name FROM users ORDER BY id LIMIT 10 OFFSET 10;

# --- ORDER BY + LIMIT combined: top-N pattern ---

query II
SELECT id, name FROM users ORDER BY age DESC, name ASC LIMIT 3;
----
3	Carol
1	Alice
5	Eve

statement ok
SELECT id, name FROM users ORDER BY age DESC, name ASC LIMIT 3;

# --- ORDER BY after GROUP BY: sort aggregate results ---

query II
SELECT age, count(*) FROM users GROUP BY age ORDER BY age ASC;
----
25	2
30	2
35	1

statement ok
SELECT age, count(*) FROM users GROUP BY age ORDER BY age ASC;

# --- ORDER BY on empty table: no rows ---

statement ok
CREATE TABLE empty_tbl (x INTEGER, y VARCHAR);

query II
SELECT x, y FROM empty_tbl ORDER BY x DESC;
----

statement ok
SELECT x, y FROM empty_tbl ORDER BY x DESC;

# --- Expression OFFSET may be bound as a scalar column carried through the child CTE ---

statement ok
CREATE TABLE offset_orders (id INTEGER, price INTEGER);

statement ok
INSERT INTO offset_orders VALUES (1, 100), (2, 90), (3, 80), (4, 70), (5, 60);

statement ok
SELECT id, price FROM offset_orders ORDER BY price DESC LIMIT 2 OFFSET (SELECT COUNT(*) FROM offset_orders) / 5;

# --- LIMIT can prune child output while its child filter still reads other columns ---

statement ok
CREATE TABLE scalar_nation (name VARCHAR, nationkey INTEGER);

statement ok
INSERT INTO scalar_nation VALUES ('CANADA', 1), ('USA', 2), ('FRANCE', 3);

statement ok
CREATE TABLE customer_stats (nationkey INTEGER, total_orders INTEGER);

statement ok
INSERT INTO customer_stats VALUES (1, 10), (2, 20), (3, 30);

statement ok
SELECT total_orders FROM customer_stats WHERE nationkey = (SELECT nationkey FROM scalar_nation WHERE name IN ('USA', 'CANADA') LIMIT 1);
